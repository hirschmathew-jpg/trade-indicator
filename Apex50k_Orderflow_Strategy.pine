//@version=6
// =============================================================================
// Apex 50k OF Strategy v2 - multi-pattern, HTF-biased, regime-filtered
// -----------------------------------------------------------------------------
// Two uncorrelated entry patterns running together:
//   1. OR Breakout - first close beyond opening range with strength filter
//   2. VWAP Pullback - retest of VWAP in established trend, reversal bar
//
// Filters (all toggleable):
//   - HTF Bias: trades only with the 15m EMA50 trend direction
//   - Time-of-Day: skip first 15min chop, lunch (12-13:30 NY), last 30min
//   - Volatility Regime: skip dead bars AND extreme news/spike bars
//   - Session VWAP veto: longs only above VWAP, shorts only below
//
// Apex 50k Static protection:
//   - Daily-loss halt, trail-cushion halt, defensive size scaling
//   - Real Apex Static-50k trail floor formula
//   - 1% margin so 20 contracts actually fit on $50k
//
// Exits: 1R / 2R / 4R partial scale-out, with optional trailing stop on the
// final 1/3 (TP3) once TP2 fills.
// =============================================================================

strategy("Apex 50k OF v2", "APX-OF v2",
     overlay              = true,
     initial_capital      = 50000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.50,
     slippage             = 2,
     margin_long          = 1.0,
     margin_short         = 1.0,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ============================== INPUTS =======================================
gPat      = "Entry Patterns"
useORBrk  = input.bool(true,  "1. OR Breakout",   group = gPat)
usePull   = input.bool(true,  "2. VWAP Pullback", group = gPat)
useOFTrig = input.bool(false, "3. Pure Orderflow Triggers", group = gPat, tooltip = "Off by default - bar-level orderflow data is too noisy.")

gFilt     = "Filters"
useHTFBias  = input.bool(true,  "HTF Bias Filter (price + slope)", group = gFilt, tooltip = "Long only when HTF close > EMA AND EMA is rising. Short only when HTF close < EMA AND EMA is falling. Slope check prevents shorting bull-market pullbacks.")
htfTF       = input.timeframe("60", "HTF Timeframe", group = gFilt, tooltip = "1H default - much more stable than 15m, fewer false flips.")
htfEmaLen   = input.int(50,    "HTF EMA Length",      group = gFilt)
htfSlopeBars= input.int(3,     "HTF Slope Lookback Bars", minval = 1, maxval = 10, group = gFilt, tooltip = "Bars back to compare EMA against for slope. 3 on 1H = 3 hours.")
useVwap     = input.bool(true, "VWAP Veto",            group = gFilt)
useTimeFilt = input.bool(true, "Time-of-Day Filter",   group = gFilt)
skipFirstMin= input.int(10,    "Skip First N Min after Open", minval = 0, group = gFilt)
skipLunch   = input.bool(false,"Skip Lunch (12:00-13:30 NY)", group = gFilt, tooltip = "Off by default - blocks 1.5hr/day; only enable if your symbol dies at lunch.")
skipLastMin = input.int(15,    "Skip Last N Min before Close", minval = 0, group = gFilt)
useVolReg   = input.bool(true, "Volatility Regime Filter", group = gFilt)
atrMin      = input.float(0.3, "ATR Floor (vs 50-bar avg)",  minval = 0.1, step = 0.05, group = gFilt)
atrMax      = input.float(3.0, "ATR Ceiling (vs 50-bar avg)", minval = 1.0, step = 0.1, group = gFilt)

gSig      = "Signal Tweaks"
brkMinRng = input.float(0.5,  "OR Break Min Bar Range / ATR", minval = 0.0, step = 0.1, group = gSig)
pullDepth = input.float(0.3,  "Pullback Depth / ATR",   minval = 0.05, step = 0.05, group = gSig, tooltip = "Pullback must dip within this ATR fraction of VWAP to qualify.")
pullStreak= input.int(5,      "Min Trend Streak for Pullback", minval = 3, group = gSig, tooltip = "Bars on the trending side of VWAP required before a pullback counts.")
allowLong = input.bool(true,  "Allow Long Entries",  group = gSig)
allowShort= input.bool(true,  "Allow Short Entries", group = gSig)

gOF       = "Orderflow Engine"
ltfMode   = input.string("Auto", "Lower-TF", options = ["Auto","1S","5S","15S","1","5"], group = gOF)
imbThresh = input.float(1.8, "Imbalance Ratio",  minval = 1.3, step = 0.1, group = gOF)
imbStack  = input.int(2,     "Stacked Imb Bars", minval = 1, maxval = 5, group = gOF)
absVolMul = input.float(1.7, "Absorption Vol Mult", minval = 1.1, step = 0.1, group = gOF)
strongDel = input.float(0.20, "Strong Delta % Threshold", minval = 0.10, step = 0.05, group = gOF)

gSess     = "Session"
sessRTH   = input.session("0930-1600", "RTH (NY)",        group = gSess)
flatBy    = input.session("1555-1600", "Force-Flat (NY)", group = gSess)
orMin     = input.int(15, "Opening Range Minutes", minval = 1, maxval = 60, group = gSess)

gRisk     = "Risk / SL / TP"
slMode    = input.string("ATR", "Stop Mode", options = ["ATR","Swing","ATR + Swing"], group = gRisk)
slATR     = input.float(1.0, "ATR Stop Mult", minval = 0.3, step = 0.1, group = gRisk)
swingLen  = input.int(8,     "Swing Lookback", minval = 3, maxval = 30, group = gRisk)
atrLen    = input.int(14,    "ATR Length", group = gRisk)
tp1R      = input.float(1.0, "TP1 R", group = gRisk)
tp2R      = input.float(2.0, "TP2 R", group = gRisk)
tp3R      = input.float(4.0, "TP3 R", group = gRisk)
beAfter1  = input.bool(false, "Move SL to BE after TP1", group = gRisk)
useTrail  = input.bool(true,  "Trail Stop on Runner after TP2", group = gRisk, tooltip = "After TP2 fills, the remaining 1/3 trails with ATR for max-capture.")
trailMult = input.float(2.5,  "Runner Trail ATR Mult", minval = 0.5, step = 0.1, group = gRisk, tooltip = "2.5 lets runners breathe; 1.5 cuts them short.")
cooldown  = input.int(3,      "Cooldown Bars", minval = 0, group = gRisk)

gApex     = "Apex 50k Sizing"
riskTrade = input.float(400.0, "Max $ Risk / Trade", minval = 25.0, group = gApex)
maxCon    = input.int(20,      "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = gApex)
ovrPV     = input.float(0.0,   "Override $/Point (0 = auto)", minval = 0.0, group = gApex)

gProt     = "Apex DD Protection"
trailDD       = input.float(2000.0, "Account Trailing DD ($)",   group = gProt, tooltip = "Apex account-level trail. Strategy halts new entries when equity is within HaltCushion of this floor.")
ddLockProf    = input.float(2100.0, "Trail Lock Profit ($)",     group = gProt)
useDailyHalt  = input.bool(true,    "Halt on Daily Loss",        group = gProt)
maxDailyLoss  = input.float(800.0,  "Max Daily Loss ($)",        minval = 50, group = gProt)
useCushionHalt= input.bool(true,    "Halt on Low Cushion",       group = gProt)
trailCushion  = input.float(500.0,  "Halt Cushion ($)",          minval = 0, group = gProt)
useScaleDown  = input.bool(true,    "Scale Down Size at 2x Cushion", group = gProt)
useIntraTrail = input.bool(true,    "Intraday Peak Trail Halt",  group = gProt, tooltip = "Halt new entries AND close any open trade if today's equity drops by Intraday Trail \$ from today's peak. Stops 'giving back' winning days.")
intraTrail    = input.float(400.0,  "Intraday Peak Trail ($)",   minval = 50, group = gProt, tooltip = "Max acceptable drawdown from today's peak equity before halting. \$400 default = stops a winning day from turning into a losing day.")

// ============================== POINT VALUE ==================================
dpp = ovrPV > 0 ? ovrPV : (syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0)

// ============================== SESSION ======================================
inSess    = not na(time(timeframe.period, sessRTH, "America/New_York"))
sessFlag  = inSess ? 1 : 0
isNewSess = ta.change(sessFlag) > 0
flatNow   = not na(time(timeframe.period, flatBy, "America/New_York"))

var int sessBar = 0
sessBar := isNewSess ? 0 : inSess ? sessBar + 1 : 0

barMin = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
orBars = math.max(1, int(math.ceil(orMin / barMin)))
inOR   = inSess and sessBar < orBars

var float orH = na
var float orL = na
if isNewSess
    orH := high
    orL := low
else if inOR
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low),  low)
orReady = inSess and sessBar >= orBars

vwap      = ta.vwap(hlc3, isNewSess)
aboveVwap = inSess and close > vwap
belowVwap = inSess and close < vwap

atr = ta.atr(atrLen)

// ============================== HTF BIAS (price + slope) =====================
// Bull = HTF close above EMA AND EMA rising. Bear = below AND falling. Slope
// check prevents shorting bull-market pullbacks (where price dips under EMA
// but EMA is still trending up).
htfClose    = request.security(syminfo.tickerid, htfTF, close, lookahead = barmerge.lookahead_off)
htfEMA      = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen), lookahead = barmerge.lookahead_off)
htfEMAprev  = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen)[htfSlopeBars], lookahead = barmerge.lookahead_off)
emaRising   = not na(htfEMA) and not na(htfEMAprev) and htfEMA > htfEMAprev
emaFalling  = not na(htfEMA) and not na(htfEMAprev) and htfEMA < htfEMAprev
htfBull     = not na(htfEMA) and htfClose > htfEMA and emaRising
htfBear     = not na(htfEMA) and htfClose < htfEMA and emaFalling

// ============================== TIME-OF-DAY ==================================
nyHr   = hour(time, "America/New_York")
nyMin  = minute(time, "America/New_York")
nyTM   = nyHr * 60 + nyMin
inLunch     = skipLunch and nyTM >= 12 * 60 and nyTM < 13 * 60 + 30
inFirstSkip = nyTM < (9 * 60 + 30) + skipFirstMin
inLastSkip  = nyTM >= (16 * 60) - skipLastMin
goodTime    = not useTimeFilt or (not inLunch and not inFirstSkip and not inLastSkip)

// ============================== VOL REGIME ===================================
atrAvg = ta.sma(atr, 50)
volOK  = not useVolReg or (not na(atrAvg) and atr >= atrAvg * atrMin and atr <= atrAvg * atrMax)

// ============================== ORDERFLOW ====================================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

f_classify(o, h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
    [v * bf, v * (1.0 - bf)]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s
delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta

isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= imbStack
stackedSell = sellStreak >= imbStack

avgVol = ta.sma(volume,     math.min(20, math.max(5, sessBar + 1)))
avgRng = ta.sma(high - low, math.min(20, math.max(5, sessBar + 1)))
heavyV = volume > avgVol * absVolMul
tightR = (high - low) < avgRng * 0.5
absorbBuy  = heavyV and tightR and delta > 0 and close >= high - (high - low) * 0.30
absorbSell = heavyV and tightR and delta < 0 and close <= low  + (high - low) * 0.30

ofLong  = stackedBuy  or absorbBuy  or deltaPct >  strongDel
ofShort = stackedSell or absorbSell or deltaPct < -strongDel

// ============================== PATTERN 1: OR BREAKOUT =======================
brokeHi    = orReady and not na(orH) and close > orH
brokeLo    = orReady and not na(orL) and close < orL
strongBar  = brkMinRng <= 0 or (high - low) > atr * brkMinRng
firstBrkUp = brokeHi and not brokeHi[1] and strongBar
firstBrkDn = brokeLo and not brokeLo[1] and strongBar

orPatLong  = useORBrk and firstBrkUp
orPatShort = useORBrk and firstBrkDn

// ============================== PATTERN 2: VWAP PULLBACK =====================
// Track how long price has been on each side of VWAP in this session.
var int sessAboveVwap = 0
var int sessBelowVwap = 0
sessAboveVwap := isNewSess ? 0 : (close > vwap ? sessAboveVwap + 1 : 0)
sessBelowVwap := isNewSess ? 0 : (close < vwap ? sessBelowVwap + 1 : 0)

// Pullback long: was trending above VWAP, this bar dipped to within depth*ATR
// of VWAP, then closed back above VWAP with a bullish candle.
pullLong  = usePull and orReady and sessAboveVwap[1] >= pullStreak and low <= vwap + atr * pullDepth and close > vwap and close > open
pullShort = usePull and orReady and sessBelowVwap[1] >= pullStreak and high >= vwap - atr * pullDepth and close < vwap and close < open

// ============================== PATTERN 3: PURE ORDERFLOW ====================
ofPatLong  = useOFTrig and ofLong  and orReady
ofPatShort = useOFTrig and ofShort and orReady

// ============================== COMBINED TRIGGER + FILTERS ===================
triggerLong  = orPatLong  or pullLong  or ofPatLong
triggerShort = orPatShort or pullShort or ofPatShort

vetoLong  = not useVwap or aboveVwap
vetoShort = not useVwap or belowVwap

htfOKLong  = not useHTFBias or htfBull
htfOKShort = not useHTFBias or htfBear

allFiltersLong  = goodTime and volOK and vetoLong  and htfOKLong
allFiltersShort = goodTime and volOK and vetoShort and htfOKShort

rawLong  = allowLong  and inSess and not flatNow and triggerLong  and allFiltersLong
rawShort = allowShort and inSess and not flatNow and triggerShort and allFiltersShort

var int lastSig = -1000
canFire = bar_index - lastSig >= cooldown

// ============================== APEX PROTECTION ==============================
// Day-start equity (resets at session open).
var float dayStartEq = na
if isNewSess
    dayStartEq := strategy.equity
dayPnL = strategy.equity - nz(dayStartEq, strategy.initial_capital)

// Intraday peak equity (resets at session open) + drawdown-from-peak tracking.
var float dayPeakEq = na
if isNewSess
    dayPeakEq := strategy.equity
else
    dayPeakEq := math.max(nz(dayPeakEq, strategy.equity), strategy.equity)
intraDD = nz(dayPeakEq, strategy.equity) - strategy.equity

// Account-wide peak (Apex trail floor).
var float peakEq = strategy.initial_capital
peakEq := math.max(peakEq, strategy.equity)
peakForTrail = math.min(peakEq, strategy.initial_capital + ddLockProf)
trailFloor   = peakForTrail - trailDD
cushion      = strategy.equity - trailFloor

dailyHalt    = useDailyHalt   and dayPnL  <= -maxDailyLoss
cushionHalt  = useCushionHalt and cushion <  trailCushion
intraHalt    = useIntraTrail  and intraDD >= intraTrail
canTrade     = not dailyHalt and not cushionHalt and not intraHalt

// CLOSE the open position when intraday-trail breaches (gives back gains).
if intraHalt and strategy.position_size != 0
    strategy.close_all(comment = "IntraTrail halt")

sizeScale = useScaleDown and cushion < trailCushion * 2.0 ? 0.5 : 1.0

// ============================== SL / TP ======================================
swingLow  = ta.lowest(low,   math.min(swingLen, math.max(2, sessBar + 1)))
swingHigh = ta.highest(high, math.min(swingLen, math.max(2, sessBar + 1)))

f_long_sl(e) =>
    sla = e - atr * slATR
    sls = swingLow - syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.min(sla, sls)
f_short_sl(e) =>
    sla = e + atr * slATR
    sls = swingHigh + syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.max(sla, sls)

// ============================== TRADE STATE ==================================
var float aE   = na
var float aS   = na
var float aT1  = na
var float aT2  = na
var float aT3  = na
var int   aQ1  = 0
var int   aQ2  = 0
var int   aDir = 0
var bool  aTp1 = false
var bool  aTp2 = false
var float aTrail = na

if strategy.position_size == 0
    aDir := 0
    aTp1 := false
    aTp2 := false
    aTrail := na

if flatNow and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")

// ============================== ENTRIES ======================================
if rawLong and canFire and strategy.position_size == 0 and not flatNow and canTrade
    e  = close
    sl = f_long_sl(e)
    rd = e - sl
    if not na(sl) and rd > 0
        rawQty = math.floor(riskTrade / (rd * dpp))
        qty    = math.max(1, math.min(maxCon, int(math.floor(rawQty * sizeScale))))
        q1     = math.max(1, math.floor(qty / 3))
        q2     = math.max(1, math.floor(qty / 3))
        aE   := e
        aS   := sl
        aT1  := e + rd * tp1R
        aT2  := e + rd * tp2R
        aT3  := e + rd * tp3R
        aQ1  := q1
        aQ2  := q2
        aDir := 1
        aTp1 := false
        aTp2 := false
        aTrail := na
        lastSig := bar_index
        strategy.entry("L", strategy.long, qty = qty)
        strategy.exit("L-TP1", from_entry = "L", qty = q1, limit = aT1, stop = aS)
        strategy.exit("L-TP2", from_entry = "L", qty = q2, limit = aT2, stop = aS)
        strategy.exit("L-TP3", from_entry = "L",            limit = aT3, stop = aS)

if rawShort and canFire and strategy.position_size == 0 and not flatNow and canTrade
    e  = close
    sl = f_short_sl(e)
    rd = sl - e
    if not na(sl) and rd > 0
        rawQty = math.floor(riskTrade / (rd * dpp))
        qty    = math.max(1, math.min(maxCon, int(math.floor(rawQty * sizeScale))))
        q1     = math.max(1, math.floor(qty / 3))
        q2     = math.max(1, math.floor(qty / 3))
        aE   := e
        aS   := sl
        aT1  := e - rd * tp1R
        aT2  := e - rd * tp2R
        aT3  := e - rd * tp3R
        aQ1  := q1
        aQ2  := q2
        aDir := -1
        aTp1 := false
        aTp2 := false
        aTrail := na
        lastSig := bar_index
        strategy.entry("S", strategy.short, qty = qty)
        strategy.exit("S-TP1", from_entry = "S", qty = q1, limit = aT1, stop = aS)
        strategy.exit("S-TP2", from_entry = "S", qty = q2, limit = aT2, stop = aS)
        strategy.exit("S-TP3", from_entry = "S",            limit = aT3, stop = aS)

// ============================== TP1/TP2 DETECTION + DYN STOP =================
if aDir ==  1 and not aTp1 and not na(aT1) and high >= aT1
    aTp1 := true
if aDir == -1 and not aTp1 and not na(aT1) and low  <= aT1
    aTp1 := true
if aDir ==  1 and not aTp2 and not na(aT2) and high >= aT2
    aTp2 := true
if aDir == -1 and not aTp2 and not na(aT2) and low  <= aT2
    aTp2 := true

// Trailing stop on TP3 portion: starts after TP2 fills, trails ATR-distance.
if useTrail and aTp2 and aDir == 1
    newTrail = close - atr * trailMult
    aTrail := math.max(nz(aTrail, newTrail), newTrail)
if useTrail and aTp2 and aDir == -1
    newTrail = close + atr * trailMult
    aTrail := math.min(nz(aTrail, newTrail), newTrail)

// Dynamic stop: BE after TP1 (optional), trail after TP2 (optional).
dynStop2 = beAfter1 and aTp1 ? aE : aS
dynStop3 = useTrail and aTp2 and not na(aTrail) ? aTrail : (beAfter1 and aTp1 ? aE : aS)

if aDir ==  1 and strategy.position_size > 0 and bar_index > lastSig
    strategy.exit("L-TP1", from_entry = "L", qty = aQ1, limit = aT1, stop = aS)
    strategy.exit("L-TP2", from_entry = "L", qty = aQ2, limit = aT2, stop = dynStop2)
    strategy.exit("L-TP3", from_entry = "L",            limit = aT3, stop = dynStop3)
if aDir == -1 and strategy.position_size < 0 and bar_index > lastSig
    strategy.exit("S-TP1", from_entry = "S", qty = aQ1, limit = aT1, stop = aS)
    strategy.exit("S-TP2", from_entry = "S", qty = aQ2, limit = aT2, stop = dynStop2)
    strategy.exit("S-TP3", from_entry = "S",            limit = aT3, stop = dynStop3)

// ============================== VISUALS ======================================
plot(inSess ? vwap : na, "VWAP",    color = color.new(color.yellow, 0), linewidth = 2)
plot(inSess ? orH  : na, "OR High", color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess ? orL  : na, "OR Low",  color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess and useHTFBias ? htfEMA : na, "HTF EMA", color = color.new(color.fuchsia, 30), linewidth = 1)

plotshape(rawLong  and canFire and canTrade and strategy.position_size == 0, "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(rawShort and canFire and canTrade and strategy.position_size == 0, "SELL", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL", textcolor = color.white, size = size.small)

// Pattern dots so you can see which trigger fired.
plotshape(orPatLong,  "ORBL",  shape.circle, location.belowbar, color.new(color.green,  60), size = size.tiny)
plotshape(pullLong,   "PullL", shape.cross,  location.belowbar, color.new(color.lime,   30), size = size.tiny)
plotshape(orPatShort, "ORBS",  shape.circle, location.abovebar, color.new(color.red,    60), size = size.tiny)
plotshape(pullShort,  "PullS", shape.cross,  location.abovebar, color.new(color.maroon, 30), size = size.tiny)

bgcolor(inSess ? na : color.new(color.gray, 92), title = "Outside Session")
bgcolor(dailyHalt or cushionHalt ? color.new(color.red, 88) : na, title = "Halt")
bgcolor(inSess and not goodTime ? color.new(color.orange, 92) : na, title = "Bad Time")
bgcolor(inSess and not volOK ? color.new(color.purple, 92) : na, title = "Vol Regime Block")

// ============================== DIAG TABLE ===================================
if barstate.islast
    var table dbg = table.new(position.bottom_right, 2, 14, border_width = 1)
    bgL = color.new(color.silver, 30)
    bgV = color.new(color.white,  0)
    table.cell(dbg, 0, 0, "DIAG v2",                   bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0, str.tostring(strategy.closedtrades) + " trades", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 1, "Equity",       bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 1, "$" + str.tostring(strategy.equity, "#.##"), bgcolor = bgV, text_color = strategy.equity >= strategy.initial_capital ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 2, "Cushion",      bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 2, "$" + str.tostring(cushion, "#.##"), bgcolor = bgV, text_color = cushion < trailCushion ? color.red : cushion < trailCushion * 2 ? color.orange : color.green, text_size = size.tiny)
    table.cell(dbg, 0, 3, "Day PnL",      bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 3, "$" + str.tostring(dayPnL, "#.##") + "  (peak: $" + str.tostring(nz(dayPeakEq - strategy.initial_capital, 0), "#.##") + ", DD: $" + str.tostring(intraDD, "#.##") + ")", bgcolor = bgV, text_color = dayPnL >= 0 ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 4, "$/pt",         bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 4, "$" + str.tostring(dpp, "#.##"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 5, "Size scale",   bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 5, str.tostring(sizeScale * 100, "#") + "%", bgcolor = bgV, text_color = sizeScale < 1.0 ? color.orange : color.black, text_size = size.tiny)
    haltStr = dailyHalt ? "DAILY-LOSS" : cushionHalt ? "CUSHION" : intraHalt ? "INTRA-TRAIL" : flatNow ? "EOD WINDOW" : "OK"
    table.cell(dbg, 0, 6, "Halt",         bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 6, haltStr, bgcolor = bgV, text_color = haltStr == "OK" ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 7, "HTF bias",     bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    htfStr = htfBull ? "BULL" : htfBear ? "BEAR" : "FLAT"
    table.cell(dbg, 1, 7, htfStr, bgcolor = bgV, text_color = htfBull ? color.green : htfBear ? color.red : color.black, text_size = size.tiny)
    table.cell(dbg, 0, 8, "Vol regime",   bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 8, volOK ? "OK" : "BLOCKED", bgcolor = bgV, text_color = volOK ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 9, "Time window",  bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 9, goodTime ? "OK" : (inLunch ? "LUNCH" : inFirstSkip ? "OPEN" : "CLOSE"), bgcolor = bgV, text_color = goodTime ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 10, "OR ready",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 10, orReady ? "YES" : "NO", bgcolor = bgV, text_color = orReady ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 11, "OR pat L/S",  bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 11, (orPatLong ? "Y" : "N") + " / " + (orPatShort ? "Y" : "N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 12, "Pull L/S",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 12, (pullLong ? "Y" : "N") + " / " + (pullShort ? "Y" : "N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 13, "Cooldown",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 13, canFire ? "READY" : "WAIT", bgcolor = bgV, text_color = canFire ? color.green : color.red, text_size = size.tiny)
