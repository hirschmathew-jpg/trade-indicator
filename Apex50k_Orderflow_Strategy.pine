//@version=6
// =============================================================================
// Apex 50k Orderflow Strategy - tuned for 20-contract sizing + DD safety
// -----------------------------------------------------------------------------
// Defaults:
//   - ATR-only stop, 1.0x ATR (tight) -> sizes to 15-20 micro contracts
//   - $400 risk/trade, $250 with cushion-scale fallback near DD wall
//   - Daily loss halt at $800, cushion halt at $500 from trail floor
//   - 1R / 2R / 4R targets, BE-after-TP1 OFF (let runners run)
//   - 1% margin so 20 contracts actually fit on a 50k account
// =============================================================================

strategy("Apex 50k OF Strategy", "APX-OF",
     overlay              = true,
     initial_capital      = 50000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.50,
     slippage             = 2,
     margin_long          = 1.0,
     margin_short         = 1.0,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ============================== INPUTS =======================================
gSig      = "Signal"
useORBrk  = input.bool(true,  "OR Breakout Trigger",  group = gSig)
useOFTrig = input.bool(false, "Orderflow Triggers (imb/absorb/delta)", group = gSig)
useVwap   = input.bool(true,  "Require VWAP Side (veto)",  group = gSig)
useOFConf = input.bool(false, "Require Orderflow Confirm on OR Break", group = gSig)
brkMinRng = input.float(0.5,  "Min Breakout Bar Range / ATR",  minval = 0.0, step = 0.1, group = gSig, tooltip = "Filters wick fakeouts. Bar's range must be at least this fraction of ATR. 0 = disabled.")
allowLong = input.bool(true,  "Allow Long Entries",  group = gSig)
allowShort= input.bool(true,  "Allow Short Entries", group = gSig)

gOF       = "Orderflow"
ltfMode   = input.string("Auto", "Lower-TF", options = ["Auto","1S","5S","15S","1","5"], group = gOF)
imbThresh = input.float(1.8, "Imbalance Ratio",        minval = 1.3, step = 0.1, group = gOF)
imbStack  = input.int(2,     "Stacked Imbalance Bars", minval = 1, maxval = 5, group = gOF)
absVolMul = input.float(1.7, "Absorption Vol Mult",    minval = 1.1, step = 0.1, group = gOF)
strongDel = input.float(0.20, "Strong Delta % Threshold", minval = 0.10, step = 0.05, group = gOF)

gSess     = "Session"
sessRTH   = input.session("0930-1600", "RTH (NY)",        group = gSess)
flatBy    = input.session("1555-1600", "Force-Flat (NY)", group = gSess)
orMin     = input.int(15, "Opening Range Minutes", minval = 1, maxval = 60, group = gSess)

gRisk     = "Risk / SL / TP"
slMode    = input.string("ATR", "Stop Mode", options = ["ATR","Swing","ATR + Swing"], group = gRisk, tooltip = "ATR-only gives consistent tight stops -> sizes up to ~20 contracts. Swing-based can produce very wide stops -> small contracts.")
slATR     = input.float(1.0, "ATR Stop Mult", minval = 0.3, step = 0.1, group = gRisk, tooltip = "Tighter = bigger position size. 1.0 default targets 15-20 micro contracts.")
swingLen  = input.int(8,     "Swing Lookback", minval = 3, maxval = 30, group = gRisk)
atrLen    = input.int(14,    "ATR Length", group = gRisk)
tp1R      = input.float(1.0, "TP1 R", group = gRisk)
tp2R      = input.float(2.0, "TP2 R", group = gRisk)
tp3R      = input.float(4.0, "TP3 R", group = gRisk, tooltip = "Bigger TP3 captures runner trades that justify the strategy edge.")
beAfter1  = input.bool(false, "Move SL to BE after TP1", group = gRisk)
cooldown  = input.int(5,     "Cooldown Bars", minval = 0, group = gRisk)

gApex     = "Apex 50k Sizing"
riskTrade = input.float(400.0, "Max $ Risk / Trade", minval = 25.0, group = gApex)
maxCon    = input.int(20,      "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = gApex)
ovrPV     = input.float(0.0,   "Override $/Point (0 = auto)", minval = 0.0, group = gApex)

gProt     = "Apex DD Protection"
trailDD       = input.float(2000.0, "Trailing Drawdown ($)",     group = gProt)
ddLockProf    = input.float(2100.0, "Trail Lock Profit ($)",     group = gProt, tooltip = "Apex Static 50k: trail floor freezes once peak hits start + this amount.")
useDailyHalt  = input.bool(true,    "Halt on Daily Loss",        group = gProt)
maxDailyLoss  = input.float(800.0,  "Max Daily Loss ($)",        minval = 50, group = gProt, tooltip = "Halt new entries for the rest of the day if cumulative loss reaches this amount. ~2 losing trades worth.")
useCushionHalt= input.bool(true,    "Halt on Low Cushion",       group = gProt)
trailCushion  = input.float(500.0,  "Halt Cushion ($)",          minval = 0, group = gProt, tooltip = "Halt new entries if equity is within this amount of the trail floor.")
useScaleDown  = input.bool(true,    "Scale Down Size at 2x Cushion", group = gProt, tooltip = "Halve position size when cushion is below 2x halt threshold (\$1000 by default).")

// ============================== POINT VALUE (auto) ===========================
dpp = ovrPV > 0 ? ovrPV : (syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0)

// ============================== SESSION ======================================
inSess    = not na(time(timeframe.period, sessRTH, "America/New_York"))
sessFlag  = inSess ? 1 : 0
isNewSess = ta.change(sessFlag) > 0
flatNow   = not na(time(timeframe.period, flatBy, "America/New_York"))

var int sessBar = 0
sessBar := isNewSess ? 0 : inSess ? sessBar + 1 : 0

barMin = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
orBars = math.max(1, int(math.ceil(orMin / barMin)))
inOR   = inSess and sessBar < orBars

var float orH = na
var float orL = na
if isNewSess
    orH := high
    orL := low
else if inOR
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low),  low)
orReady = inSess and sessBar >= orBars

vwap      = ta.vwap(hlc3, isNewSess)
aboveVwap = inSess and close > vwap
belowVwap = inSess and close < vwap

atr = ta.atr(atrLen)

// ============================== ORDERFLOW ====================================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

f_classify(o, h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
    [v * bf, v * (1.0 - bf)]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s
delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta

isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= imbStack
stackedSell = sellStreak >= imbStack

avgVol = ta.sma(volume,     math.min(20, math.max(5, sessBar + 1)))
avgRng = ta.sma(high - low, math.min(20, math.max(5, sessBar + 1)))
heavyV = volume > avgVol * absVolMul
tightR = (high - low) < avgRng * 0.5
absorbBuy  = heavyV and tightR and delta > 0 and close >= high - (high - low) * 0.30
absorbSell = heavyV and tightR and delta < 0 and close <= low  + (high - low) * 0.30

ofLong  = stackedBuy  or absorbBuy  or deltaPct >  strongDel
ofShort = stackedSell or absorbSell or deltaPct < -strongDel

// ============================== TRIGGERS =====================================
brokeHi = orReady and not na(orH) and close > orH
brokeLo = orReady and not na(orL) and close < orL
strongBar = brkMinRng <= 0 or (high - low) > atr * brkMinRng
firstBrkUp = brokeHi and not brokeHi[1] and strongBar
firstBrkDn = brokeLo and not brokeLo[1] and strongBar

orTrigLong   = useORBrk and firstBrkUp and (not useOFConf or ofLong)
orTrigShort  = useORBrk and firstBrkDn and (not useOFConf or ofShort)
ofTrigLong   = useOFTrig and ofLong  and orReady
ofTrigShort  = useOFTrig and ofShort and orReady

triggerLong  = orTrigLong  or ofTrigLong
triggerShort = orTrigShort or ofTrigShort

vetoLong  = not useVwap or aboveVwap
vetoShort = not useVwap or belowVwap

rawLong  = allowLong  and inSess and not flatNow and triggerLong  and vetoLong
rawShort = allowShort and inSess and not flatNow and triggerShort and vetoShort

var int lastSig = -1000
canFire = bar_index - lastSig >= cooldown

// ============================== APEX PROTECTION ==============================
// Day PnL tracking - resets each session.
var float dayStartEq = na
if isNewSess
    dayStartEq := strategy.equity
dayPnL = strategy.equity - nz(dayStartEq, strategy.initial_capital)

// Peak equity for trailing-drawdown calc.
var float peakEq = strategy.initial_capital
peakEq := math.max(peakEq, strategy.equity)

// Apex Static 50k trail: peak caps at start+lockProfit; below that it trails
// peak - trailDD; above lock, the floor freezes at start+lockProfit-trailDD.
peakForTrail = math.min(peakEq, strategy.initial_capital + ddLockProf)
trailFloor   = peakForTrail - trailDD
cushion      = strategy.equity - trailFloor

dailyHalt   = useDailyHalt and dayPnL <= -maxDailyLoss
cushionHalt = useCushionHalt and cushion < trailCushion
canTrade    = not dailyHalt and not cushionHalt

// Defensive size scaling - halve qty when cushion is in the danger zone.
sizeScale = useScaleDown and cushion < trailCushion * 2.0 ? 0.5 : 1.0

// ============================== SL / TP ======================================
swingLow  = ta.lowest(low,   math.min(swingLen, math.max(2, sessBar + 1)))
swingHigh = ta.highest(high, math.min(swingLen, math.max(2, sessBar + 1)))

f_long_sl(e) =>
    sla = e - atr * slATR
    sls = swingLow - syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.min(sla, sls)
f_short_sl(e) =>
    sla = e + atr * slATR
    sls = swingHigh + syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.max(sla, sls)

// ============================== TRADE STATE ==================================
var float aE   = na
var float aS   = na
var float aT1  = na
var float aT2  = na
var float aT3  = na
var int   aQ1  = 0
var int   aQ2  = 0
var int   aDir = 0
var bool  aTp1 = false

if strategy.position_size == 0
    aDir := 0
    aTp1 := false

if flatNow and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")

// ============================== ENTRIES ======================================
if rawLong and canFire and strategy.position_size == 0 and not flatNow and canTrade
    e  = close
    sl = f_long_sl(e)
    rd = e - sl
    if not na(sl) and rd > 0
        rawQty = math.floor(riskTrade / (rd * dpp))
        qty    = math.max(1, math.min(maxCon, int(math.floor(rawQty * sizeScale))))
        q1     = math.max(1, math.floor(qty / 3))
        q2     = math.max(1, math.floor(qty / 3))
        aE   := e
        aS   := sl
        aT1  := e + rd * tp1R
        aT2  := e + rd * tp2R
        aT3  := e + rd * tp3R
        aQ1  := q1
        aQ2  := q2
        aDir := 1
        aTp1 := false
        lastSig := bar_index
        strategy.entry("L", strategy.long, qty = qty)
        strategy.exit("L-TP1", from_entry = "L", qty = q1, limit = aT1, stop = aS)
        strategy.exit("L-TP2", from_entry = "L", qty = q2, limit = aT2, stop = aS)
        strategy.exit("L-TP3", from_entry = "L",            limit = aT3, stop = aS)

if rawShort and canFire and strategy.position_size == 0 and not flatNow and canTrade
    e  = close
    sl = f_short_sl(e)
    rd = sl - e
    if not na(sl) and rd > 0
        rawQty = math.floor(riskTrade / (rd * dpp))
        qty    = math.max(1, math.min(maxCon, int(math.floor(rawQty * sizeScale))))
        q1     = math.max(1, math.floor(qty / 3))
        q2     = math.max(1, math.floor(qty / 3))
        aE   := e
        aS   := sl
        aT1  := e - rd * tp1R
        aT2  := e - rd * tp2R
        aT3  := e - rd * tp3R
        aQ1  := q1
        aQ2  := q2
        aDir := -1
        aTp1 := false
        lastSig := bar_index
        strategy.entry("S", strategy.short, qty = qty)
        strategy.exit("S-TP1", from_entry = "S", qty = q1, limit = aT1, stop = aS)
        strategy.exit("S-TP2", from_entry = "S", qty = q2, limit = aT2, stop = aS)
        strategy.exit("S-TP3", from_entry = "S",            limit = aT3, stop = aS)

// ============================== BE-AFTER-TP1 =================================
if aDir ==  1 and not aTp1 and not na(aT1) and high >= aT1
    aTp1 := true
if aDir == -1 and not aTp1 and not na(aT1) and low  <= aT1
    aTp1 := true

dynStop = beAfter1 and aTp1 ? aE : aS

if aDir ==  1 and strategy.position_size > 0 and bar_index > lastSig
    strategy.exit("L-TP1", from_entry = "L", qty = aQ1, limit = aT1, stop = aS)
    strategy.exit("L-TP2", from_entry = "L", qty = aQ2, limit = aT2, stop = dynStop)
    strategy.exit("L-TP3", from_entry = "L",            limit = aT3, stop = dynStop)
if aDir == -1 and strategy.position_size < 0 and bar_index > lastSig
    strategy.exit("S-TP1", from_entry = "S", qty = aQ1, limit = aT1, stop = aS)
    strategy.exit("S-TP2", from_entry = "S", qty = aQ2, limit = aT2, stop = dynStop)
    strategy.exit("S-TP3", from_entry = "S",            limit = aT3, stop = dynStop)

// ============================== VISUALS ======================================
plot(inSess ? vwap : na, "VWAP",    color = color.new(color.yellow, 0), linewidth = 2)
plot(inSess ? orH  : na, "OR High", color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess ? orL  : na, "OR Low",  color = color.new(color.aqua,    0), style = plot.style_linebr)

plotshape(rawLong  and canFire and canTrade and strategy.position_size == 0, "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(rawShort and canFire and canTrade and strategy.position_size == 0, "SELL", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL", textcolor = color.white, size = size.small)

bgcolor(inSess ? na : color.new(color.gray, 92), title = "Outside Session")
bgcolor(dailyHalt or cushionHalt ? color.new(color.red, 88) : na, title = "Halt")

// ============================== DIAG TABLE ===================================
if barstate.islast
    var table dbg = table.new(position.bottom_right, 2, 12, border_width = 1)
    bgL = color.new(color.silver, 30)
    bgV = color.new(color.white,  0)
    table.cell(dbg, 0, 0, "DIAG",                              bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0, str.tostring(strategy.closedtrades) + " trades", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 1, "Equity",                bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 1, "$" + str.tostring(strategy.equity, "#.##"), bgcolor = bgV, text_color = strategy.equity >= strategy.initial_capital ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 2, "Peak",                  bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 2, "$" + str.tostring(peakEq, "#.##"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 3, "Trail floor",           bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 3, "$" + str.tostring(trailFloor, "#.##"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 4, "Cushion",               bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 4, "$" + str.tostring(cushion, "#.##"), bgcolor = bgV, text_color = cushion < trailCushion ? color.red : cushion < trailCushion * 2 ? color.orange : color.green, text_size = size.tiny)
    table.cell(dbg, 0, 5, "Day PnL",               bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 5, "$" + str.tostring(dayPnL, "#.##"), bgcolor = bgV, text_color = dayPnL >= 0 ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 6, "Symbol $/pt",           bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 6, "$" + str.tostring(dpp, "#.##"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 7, "Size scale",            bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 7, str.tostring(sizeScale * 100, "#") + "%", bgcolor = bgV, text_color = sizeScale < 1.0 ? color.orange : color.black, text_size = size.tiny)
    haltStr = dailyHalt ? "DAILY-LOSS" : cushionHalt ? "CUSHION" : flatNow ? "EOD WINDOW" : "OK"
    table.cell(dbg, 0, 8, "Halt",                  bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 8, haltStr, bgcolor = bgV, text_color = haltStr == "OK" ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 9, "In RTH",                bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 9, inSess ? "YES" : "NO", bgcolor = bgV, text_color = inSess ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 10, "OR ready",             bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 10, orReady ? "YES" : "NO", bgcolor = bgV, text_color = orReady ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 11, "Trig L/S",             bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 11, (triggerLong ? "Y" : "N") + " / " + (triggerShort ? "Y" : "N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
