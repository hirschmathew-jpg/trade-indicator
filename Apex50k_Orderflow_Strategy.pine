//@version=6
// =============================================================================
// Apex 50k Orderflow Strategy - clean session-only intraday MNQ
// -----------------------------------------------------------------------------
// Logic: TRIGGER + CONFIRMATION + (optional) VWAP veto.
//   Trigger    = stacked imbalance OR absorption OR strong delta bar
//   Confirm    = session CVD on signal side OR break of opening range
//   Veto       = session VWAP side (toggle)
// Risk: ATR + swing stop, three scale-out exits at 1R/2R/3R, BE after TP1.
// =============================================================================

strategy("Apex 50k OF Strategy", "APX-OF",
     overlay              = true,
     initial_capital      = 50000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.50,
     slippage             = 2,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ============================== INPUTS =======================================
gOF       = "Orderflow"
ltfMode   = input.string("Auto", "Lower-TF", options = ["Auto","1S","5S","15S","1","5"], group = gOF)
imbThresh = input.float(1.8, "Imbalance Ratio",       minval = 1.3, step = 0.1, group = gOF)
imbStack  = input.int(2,     "Stacked Imbalance Bars", minval = 1, maxval = 5, group = gOF)
absVolMul = input.float(1.7, "Absorption Vol Mult",   minval = 1.1, step = 0.1, group = gOF)
strongDel = input.float(0.25, "Strong Delta % Threshold", minval = 0.10, step = 0.05, group = gOF, tooltip = "Bar's net delta as fraction of total volume to count as strong directional pressure.")

gSess     = "Session"
sessRTH   = input.session("0930-1600", "RTH (NY)",        group = gSess)
flatBy    = input.session("1555-1600", "Force-Flat (NY)", group = gSess)
orMin     = input.int(5,    "Opening Range Minutes",   minval = 1, maxval = 30, group = gSess)
useVwap   = input.bool(true, "Require VWAP Side (veto)", group = gSess)

gRisk     = "Risk / SL / TP"
slMode    = input.string("ATR + Swing", "Stop Mode", options = ["ATR","Swing","ATR + Swing"], group = gRisk)
slATR     = input.float(1.2, "ATR Stop Mult", minval = 0.3, step = 0.1, group = gRisk)
swingLen  = input.int(8,     "Swing Lookback", minval = 3, maxval = 30, group = gRisk)
atrLen    = input.int(14,    "ATR Length", group = gRisk)
tp1R      = input.float(1.0, "TP1 R", group = gRisk)
tp2R      = input.float(2.0, "TP2 R", group = gRisk)
tp3R      = input.float(3.0, "TP3 R", group = gRisk)
beAfter1  = input.bool(true, "Move SL to BE after TP1", group = gRisk)
cooldown  = input.int(5,     "Cooldown Bars", minval = 0, group = gRisk)

gApex     = "Apex 50k"
sym       = input.string("MNQ", "Instrument", options = ["MES","MNQ","MGC","MCL","ES","NQ","GC","CL"], group = gApex)
riskTrade = input.float(400.0, "Max $ Risk / Trade", minval = 25.0, group = gApex)
maxCon    = input.int(20,      "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = gApex)

// ============================== INSTRUMENT MAP ===============================
dpp = sym == "MES" ? 5.0 : sym == "MNQ" ? 2.0 : sym == "MGC" ? 10.0 : sym == "MCL" ? 100.0 : sym == "ES" ? 50.0 : sym == "NQ" ? 20.0 : sym == "GC" ? 100.0 : sym == "CL" ? 1000.0 : 1.0

// ============================== SESSION ======================================
inSess    = not na(time(timeframe.period, sessRTH, "America/New_York"))
sessFlag  = inSess ? 1 : 0
isNewSess = ta.change(sessFlag) > 0
flatNow   = not na(time(timeframe.period, flatBy, "America/New_York"))

var int sessBar = 0
sessBar := isNewSess ? 0 : inSess ? sessBar + 1 : 0

barMin = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
orBars = math.max(1, int(math.ceil(orMin / barMin)))
inOR   = inSess and sessBar < orBars

var float orH = na
var float orL = na
if isNewSess
    orH := high
    orL := low
else if inOR
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low),  low)
orReady   = inSess and sessBar >= orBars
brokeORHi = orReady and close > orH
brokeORLo = orReady and close < orL

vwap      = ta.vwap(hlc3, isNewSess)
aboveVwap = inSess and close > vwap
belowVwap = inSess and close < vwap

atr = ta.atr(atrLen)

// ============================== DELTA / CVD ==================================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

f_classify(o, h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
    [v * bf, v * (1.0 - bf)]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s
delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta

// ============================== TRIGGERS =====================================
isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= imbStack
stackedSell = sellStreak >= imbStack

avgVol = ta.sma(volume,        math.min(20, math.max(5, sessBar + 1)))
avgRng = ta.sma(high - low,    math.min(20, math.max(5, sessBar + 1)))
heavyV = volume > avgVol * absVolMul
tightR = (high - low) < avgRng * 0.5
absorbBuy  = heavyV and tightR and delta > 0 and close >= high - (high - low) * 0.30
absorbSell = heavyV and tightR and delta < 0 and close <= low  + (high - low) * 0.30

strongUp = deltaPct >  strongDel
strongDn = deltaPct < -strongDel

triggerLong  = stackedBuy  or absorbBuy  or strongUp
triggerShort = stackedSell or absorbSell or strongDn

// ============================== CONFIRMATIONS ================================
confirmLong  = brokeORHi or cvd > 0
confirmShort = brokeORLo or cvd < 0

// ============================== VETO + SIGNAL ================================
vwapOKLong  = not useVwap or aboveVwap
vwapOKShort = not useVwap or belowVwap

rawLong  = inSess and orReady and not flatNow and triggerLong  and confirmLong  and vwapOKLong
rawShort = inSess and orReady and not flatNow and triggerShort and confirmShort and vwapOKShort

var int lastSig = -1000
canFire = bar_index - lastSig >= cooldown

// ============================== SL / TP ======================================
swingLow  = ta.lowest(low,   math.min(swingLen, math.max(2, sessBar + 1)))
swingHigh = ta.highest(high, math.min(swingLen, math.max(2, sessBar + 1)))

f_long_sl(e) =>
    sla = e - atr * slATR
    sls = swingLow - syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.min(sla, sls)
f_short_sl(e) =>
    sla = e + atr * slATR
    sls = swingHigh + syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.max(sla, sls)

// ============================== TRADE STATE ==================================
var float aEntry = na
var float aStop  = na
var float aTP1   = na
var float aTP2   = na
var float aTP3   = na
var int   aQ1    = 0
var int   aQ2    = 0
var int   aDir   = 0
var bool  aTp1H  = false

if strategy.position_size == 0
    aDir  := 0
    aTp1H := false

if flatNow and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")

// ============================== ENTRIES ======================================
if rawLong and canFire and strategy.position_size == 0 and not flatNow
    e  = close
    sl = f_long_sl(e)
    rd = e - sl
    if not na(sl) and rd > 0
        qty = math.max(1, math.min(maxCon, math.floor(riskTrade / (rd * dpp))))
        q1  = math.max(1, math.floor(qty / 3))
        q2  = math.max(1, math.floor(qty / 3))
        aEntry := e
        aStop  := sl
        aTP1   := e + rd * tp1R
        aTP2   := e + rd * tp2R
        aTP3   := e + rd * tp3R
        aQ1    := q1
        aQ2    := q2
        aDir   := 1
        aTp1H  := false
        lastSig := bar_index
        strategy.entry("L", strategy.long, qty = qty)
        strategy.exit("L-TP1", from_entry = "L", qty = q1, limit = aTP1, stop = aStop)
        strategy.exit("L-TP2", from_entry = "L", qty = q2, limit = aTP2, stop = aStop)
        strategy.exit("L-TP3", from_entry = "L",            limit = aTP3, stop = aStop)

if rawShort and canFire and strategy.position_size == 0 and not flatNow
    e  = close
    sl = f_short_sl(e)
    rd = sl - e
    if not na(sl) and rd > 0
        qty = math.max(1, math.min(maxCon, math.floor(riskTrade / (rd * dpp))))
        q1  = math.max(1, math.floor(qty / 3))
        q2  = math.max(1, math.floor(qty / 3))
        aEntry := e
        aStop  := sl
        aTP1   := e - rd * tp1R
        aTP2   := e - rd * tp2R
        aTP3   := e - rd * tp3R
        aQ1    := q1
        aQ2    := q2
        aDir   := -1
        aTp1H  := false
        lastSig := bar_index
        strategy.entry("S", strategy.short, qty = qty)
        strategy.exit("S-TP1", from_entry = "S", qty = q1, limit = aTP1, stop = aStop)
        strategy.exit("S-TP2", from_entry = "S", qty = q2, limit = aTP2, stop = aStop)
        strategy.exit("S-TP3", from_entry = "S",            limit = aTP3, stop = aStop)

// ============================== BE-AFTER-TP1 =================================
if aDir ==  1 and not aTp1H and not na(aTP1) and high >= aTP1
    aTp1H := true
if aDir == -1 and not aTp1H and not na(aTP1) and low  <= aTP1
    aTp1H := true

dynStop = beAfter1 and aTp1H ? aEntry : aStop

if aDir ==  1 and strategy.position_size > 0 and bar_index > lastSig
    strategy.exit("L-TP1", from_entry = "L", qty = aQ1, limit = aTP1, stop = aStop)
    strategy.exit("L-TP2", from_entry = "L", qty = aQ2, limit = aTP2, stop = dynStop)
    strategy.exit("L-TP3", from_entry = "L",            limit = aTP3, stop = dynStop)
if aDir == -1 and strategy.position_size < 0 and bar_index > lastSig
    strategy.exit("S-TP1", from_entry = "S", qty = aQ1, limit = aTP1, stop = aStop)
    strategy.exit("S-TP2", from_entry = "S", qty = aQ2, limit = aTP2, stop = dynStop)
    strategy.exit("S-TP3", from_entry = "S",            limit = aTP3, stop = dynStop)

// ============================== VISUALS ======================================
plot(inSess ? vwap : na, "VWAP",    color = color.new(color.yellow, 0), linewidth = 2)
plot(inSess ? orH  : na, "OR High", color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess ? orL  : na, "OR Low",  color = color.new(color.aqua,    0), style = plot.style_linebr)

plotshape(rawLong  and canFire and strategy.position_size == 0, "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(rawShort and canFire and strategy.position_size == 0, "SELL", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL", textcolor = color.white, size = size.small)

bgcolor(inSess ? na : color.new(color.gray, 92), title = "Outside Session")

// ============================== DIAG TABLE ===================================
if barstate.islast
    var table dbg = table.new(position.bottom_right, 2, 7, border_width = 1)
    bgL = color.new(color.silver, 30)
    bgV = color.new(color.white,  0)
    table.cell(dbg, 0, 0, "DIAG",                              bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0, str.tostring(strategy.closedtrades) + " trades", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 1, "In RTH",      bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 1, inSess ? "YES" : "NO", bgcolor = bgV, text_color = inSess ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 2, "OR ready",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 2, orReady ? "YES" : "NO", bgcolor = bgV, text_color = orReady ? color.green : color.red, text_size = size.tiny)
    table.cell(dbg, 0, 3, "Trig L/S",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 3, (triggerLong ? "Y" : "N") + " / " + (triggerShort ? "Y" : "N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 4, "Conf L/S",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 4, (confirmLong ? "Y" : "N") + " / " + (confirmShort ? "Y" : "N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 5, "VWAP veto OK",bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 5, (vwapOKLong ? "L=Y" : "L=N") + " " + (vwapOKShort ? "S=Y" : "S=N"), bgcolor = bgV, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 0, 6, "Cooldown",    bgcolor = bgL, text_color = color.black, text_size = size.tiny)
    table.cell(dbg, 1, 6, canFire ? "READY" : "WAIT", bgcolor = bgV, text_color = canFire ? color.green : color.red, text_size = size.tiny)
