//@version=6
// =============================================================================
// Apex 50k Orderflow Pro - STRATEGY (Session-Only)
// -----------------------------------------------------------------------------
// Pure intraday: every reference resets at the RTH open (0930 NY).
//   * No multi-day EMAs
//   * No multi-day divergence lookback
//   * Bias = session-VWAP side + opening-range break
//   * CVD, swing levels, ATR all session-anchored
//
// This trades far more often than the previous version because nothing
// requires a multi-bar historical regime. If it overtrades for your taste,
// raise "Minimum Score to Fire" from 3 to 4 or 5.
// =============================================================================

strategy("Apex 50k OF Strategy (Session)", "APX-OF Sess",
     overlay              = true,
     initial_capital      = 50000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.50,
     slippage             = 2,
     process_orders_on_close = true,
     calc_on_every_tick   = false,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ============================== INPUTS =======================================
grpOF       = "Orderflow Engine"
ltfMode     = input.string("Auto", "Lower-TF Resolution", options = ["Auto","1S","5S","10S","15S","1","5"], group = grpOF)
deltaSrc    = input.string("Close-vs-Mid", "Delta Classification", options = ["Close-vs-Open","Close-vs-Mid"], group = grpOF)
imbThresh   = input.float(2.0, "Imbalance Ratio", minval = 1.3, maxval = 10.0, step = 0.1, group = grpOF)
imbStack    = input.int(2, "Stacked Imbalance Count", minval = 1, maxval = 6, group = grpOF)
absorbMult  = input.float(1.7, "Absorption Volume Mult", minval = 1.1, step = 0.1, group = grpOF)
absorbRange = input.float(0.45, "Absorption Range Frac", minval = 0.05, maxval = 0.9, step = 0.05, group = grpOF)

grpSess     = "Session Anchors (intraday only)"
sessRTH     = input.session("0930-1600", "RTH Session (NY)", group = grpSess)
orMin       = input.int(10, "Opening Range Minutes", minval = 5, maxval = 60, group = grpSess, tooltip = "First X minutes after RTH open define the opening range used for bias.")
useORBias   = input.bool(true, "Score Opening-Range Bias", group = grpSess, tooltip = "When ON, adds +1 to score when price is on the right side of OR mid.")
useVwapF    = input.bool(true, "Score Session VWAP Side", group = grpSess, tooltip = "When ON, adds +1 to score when price is on the right side of VWAP.")
strictBias  = input.bool(false, "Strict Bias (HARD veto)", group = grpSess, tooltip = "When ON, NO long signal unless above BOTH VWAP and OR mid (and inverse for shorts). When OFF, both filters are scoring-only - the strategy will trade against VWAP/OR if other orderflow conditions are strong enough.")
flatBy      = input.session("1555-1600", "Force-Flat Window (NY)", group = grpSess)

grpScore    = "Confluence Scoring"
minScore    = input.int(2, "Minimum Score to Fire", minval = 1, maxval = 8, group = grpScore, tooltip = "Lower = more trades. Try 2 for active trading, 4 for high-conviction only.")
cooldownBars= input.int(2, "Bars Cooldown Between Signals", minval = 0, group = grpScore)

grpRisk     = "SL / TP Engine"
slMode      = input.string("ATR + Swing", "Stop Mode", options = ["ATR","Swing","ATR + Swing"], group = grpRisk)
slATRmult   = input.float(1.2, "ATR Stop Multiplier", minval = 0.3, step = 0.1, group = grpRisk)
swingLen    = input.int(8, "Swing Lookback (bars)", minval = 3, maxval = 30, group = grpRisk)
atrLen      = input.int(14, "ATR Length", group = grpRisk)
tp1R        = input.float(1.0, "TP1 (R multiple)", minval = 0.3, step = 0.1, group = grpRisk)
tp2R        = input.float(2.0, "TP2 (R multiple)", minval = 0.5, step = 0.1, group = grpRisk)
tp3R        = input.float(3.0, "TP3 (R multiple)", minval = 1.0, step = 0.1, group = grpRisk)
beAfterTP1  = input.bool(true, "Move SL to Break-Even after TP1", group = grpRisk)

grpApex     = "Apex 50k Risk"
trailDD     = input.float(2000.0, "Trailing Drawdown ($) [info]", group = grpApex, tooltip = "Displayed only - strategy doesn't halt on it.")
riskPerTrade= input.float(400.0,  "Max $ Risk / Trade", minval = 25.0, group = grpApex)
sym         = input.string("MNQ", "Instrument", options = ["MES","MNQ","MGC","MCL","ES","NQ","GC","CL"], group = grpApex)
maxContracts= input.int(20, "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = grpApex)

// ============================== INSTRUMENT MAP ===============================
var float dpp = na
if sym == "MES"
    dpp := 5.0
else if sym == "MNQ"
    dpp := 2.0
else if sym == "MGC"
    dpp := 10.0
else if sym == "MCL"
    dpp := 100.0
else if sym == "ES"
    dpp := 50.0
else if sym == "NQ"
    dpp := 20.0
else if sym == "GC"
    dpp := 100.0
else if sym == "CL"
    dpp := 1000.0

// ============================== SESSION ANCHORS ==============================
inSession   = not na(time(timeframe.period, sessRTH, "America/New_York"))
sessFlag    = inSession ? 1 : 0
isNewSess   = ta.change(sessFlag) > 0
flatNow     = not na(time(timeframe.period, flatBy, "America/New_York"))

// Bars since session open
var int sessBar = 0
sessBar := isNewSess ? 0 : inSession ? sessBar + 1 : 0

// Session high/low
var float sHigh = na
var float sLow  = na
if isNewSess
    sHigh := high
    sLow  := low
else if inSession
    sHigh := math.max(nz(sHigh, high), high)
    sLow  := math.min(nz(sLow,  low),  low)

// Opening range (first orMin minutes after session open)
barMin    = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
orBars    = math.max(1, int(math.ceil(orMin / barMin)))
inOR      = inSession and sessBar < orBars
var float orH = na
var float orL = na
if isNewSess
    orH := high
    orL := low
else if inOR
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low),  low)
orMid     = (orH + orL) / 2.0
orReady   = inSession and sessBar >= orBars
brokeORHi = orReady and close > orH
brokeORLo = orReady and close < orL
orBiasUp  = orReady and close > orMid
orBiasDn  = orReady and close < orMid

// Session VWAP - resets each session via anchored vwap
sessAnchor = isNewSess
vwap = ta.vwap(hlc3, sessAnchor)
aboveVwap = inSession and close > vwap
belowVwap = inSession and close < vwap

// Session ATR (uses standard ATR but only inside session)
atr = ta.atr(atrLen)

// ============================== DELTA / CVD (session-reset) ==================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

f_classify(o, h, l, c, v) =>
    float buy  = 0.0
    float sell = 0.0
    if deltaSrc == "Close-vs-Mid"
        rng = math.max(h - l, syminfo.mintick)
        bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
        buy  := v * bf
        sell := v * (1.0 - bf)
    else
        if c > o
            buy  := v
        else if c < o
            sell := v
        else
            buy  := v * 0.5
            sell := v * 0.5
    [buy, sell]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s
delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

// Session-anchored CVD - resets on every new RTH open. Direction flags are
// suppressed on the first bar of session (no valid prior to compare against).
var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta
cvdUp = not isNewSess and cvd > nz(cvd[1])
cvdDn = not isNewSess and cvd < nz(cvd[1])

// ============================== IMB / ABSORB =================================
isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= imbStack
stackedSell = sellStreak >= imbStack

// Session-only volume / range averages (use a short rolling window; falls back
// to whatever bars are in the session up to current).
sessVolAvg = ta.sma(volume, math.max(5, math.min(20, sessBar + 1)))
sessRngAvg = ta.sma(high - low, math.max(5, math.min(20, sessBar + 1)))
isHeavy = volume > sessVolAvg * absorbMult
isTight = (high - low) < sessRngAvg * absorbRange
absorbBuy  = isHeavy and isTight and delta > 0 and close >= (high - (high - low) * 0.35)
absorbSell = isHeavy and isTight and delta < 0 and close <= (low  + (high - low) * 0.35)

// ============================== SCORING ======================================
// Each true confirmation adds points. Higher-conviction signals = 2 pts.
longScore  = 0
shortScore = 0
longScore  += stackedBuy        ? 2 : 0
longScore  += absorbBuy         ? 2 : 0
longScore  += deltaPct > 0.20   ? 1 : 0
longScore  += cvd > 0           ? 1 : 0
longScore  += cvdUp             ? 1 : 0
longScore  += (not useVwapF)  or aboveVwap ? 1 : 0
longScore  += (not useORBias) or orBiasUp  ? 1 : 0
longScore  += brokeORHi         ? 1 : 0

shortScore += stackedSell       ? 2 : 0
shortScore += absorbSell        ? 2 : 0
shortScore += deltaPct < -0.20  ? 1 : 0
shortScore += cvd < 0           ? 1 : 0
shortScore += cvdDn             ? 1 : 0
shortScore += (not useVwapF)  or belowVwap ? 1 : 0
shortScore += (not useORBias) or orBiasDn  ? 1 : 0
shortScore += brokeORLo         ? 1 : 0

// Hard veto only when strictBias is ON. Otherwise filters are scoring-only.
longOK  = not strictBias or ((not useVwapF or aboveVwap) and (not useORBias or orBiasUp))
shortOK = not strictBias or ((not useVwapF or belowVwap) and (not useORBias or orBiasDn))

rawLong  = inSession and orReady and longOK  and longScore  >= minScore
rawShort = inSession and orReady and shortOK and shortScore >= minScore

// Cooldown - prevents back-to-back signals after a trade closes.
var int lastSig = -1000
canFire = bar_index - lastSig >= cooldownBars

// ============================== SIZE / SL / TP ===============================
// Session-only swings (only look at bars in current session).
swingLow  = ta.lowest(low,  math.min(swingLen, math.max(2, sessBar + 1)))
swingHigh = ta.highest(high, math.min(swingLen, math.max(2, sessBar + 1)))
atrStop   = atr * slATRmult
f_long_sl(entry) =>
    sla = entry - atrStop
    sls = swingLow - syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.min(sla, sls)
f_short_sl(entry) =>
    sla = entry + atrStop
    sls = swingHigh + syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.max(sla, sls)

// ============================== ACTIVE TRADE STATE ===========================
// Tracks the currently open trade so we can re-issue exits each bar with the
// correct dynamic stop (break-even kicks in only AFTER TP1 actually fills).
var float aEntry = na
var float aStop  = na
var float aTP1   = na
var float aTP2   = na
var float aTP3   = na
var int   aQty   = 0
var int   aQ1    = 0
var int   aQ2    = 0
var int   aDir   = 0
var bool  aTp1   = false

// Reset state when flat.
if strategy.position_size == 0
    aDir := 0
    aTp1 := false

// Force flat at end of session.
if flatNow and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")

// ============================== ENTRIES ======================================
// Exits are placed alongside the entry so they activate on the next bar - if
// we waited until strategy.position_size > 0 was visible, exits would only
// be placed on bar X+1 leaving the position naked on bar X.
if rawLong and canFire and strategy.position_size == 0 and not flatNow
    entry = close
    stopP = f_long_sl(entry)
    rDist = entry - stopP
    if rDist > 0 and not na(stopP)
        qty = math.floor(riskPerTrade / (rDist * dpp))
        qty := math.max(1, math.min(qty, maxContracts))
        q1  = math.max(1, math.floor(qty / 3))
        q2  = math.max(1, math.floor(qty / 3))
        aEntry := entry
        aStop  := stopP
        aTP1   := entry + rDist * tp1R
        aTP2   := entry + rDist * tp2R
        aTP3   := entry + rDist * tp3R
        aQty   := qty
        aQ1    := q1
        aQ2    := q2
        aDir   := 1
        aTp1   := false
        lastSig := bar_index
        strategy.entry("L", strategy.long, qty = qty)
        strategy.exit("L-TP1", from_entry = "L", qty = q1, limit = aTP1, stop = aStop)
        strategy.exit("L-TP2", from_entry = "L", qty = q2, limit = aTP2, stop = aStop)
        strategy.exit("L-TP3", from_entry = "L",            limit = aTP3, stop = aStop)

if rawShort and canFire and strategy.position_size == 0 and not flatNow
    entry = close
    stopP = f_short_sl(entry)
    rDist = stopP - entry
    if rDist > 0 and not na(stopP)
        qty = math.floor(riskPerTrade / (rDist * dpp))
        qty := math.max(1, math.min(qty, maxContracts))
        q1  = math.max(1, math.floor(qty / 3))
        q2  = math.max(1, math.floor(qty / 3))
        aEntry := entry
        aStop  := stopP
        aTP1   := entry - rDist * tp1R
        aTP2   := entry - rDist * tp2R
        aTP3   := entry - rDist * tp3R
        aQty   := qty
        aQ1    := q1
        aQ2    := q2
        aDir   := -1
        aTp1   := false
        lastSig := bar_index
        strategy.entry("S", strategy.short, qty = qty)
        strategy.exit("S-TP1", from_entry = "S", qty = q1, limit = aTP1, stop = aStop)
        strategy.exit("S-TP2", from_entry = "S", qty = q2, limit = aTP2, stop = aStop)
        strategy.exit("S-TP3", from_entry = "S",            limit = aTP3, stop = aStop)

// ============================== DYNAMIC STOP (BE after TP1) ==================
// On every subsequent bar we re-issue the exits so we can lift the stop on
// TP2/TP3 to break-even AFTER TP1 has actually filled. Re-issuing with the
// same ID modifies the existing OCO order rather than creating duplicates.
if aDir == 1 and not aTp1 and not na(aTP1) and high >= aTP1
    aTp1 := true
if aDir == -1 and not aTp1 and not na(aTP1) and low  <= aTP1
    aTp1 := true

dynStop = beAfterTP1 and aTp1 ? aEntry : aStop

if aDir == 1 and strategy.position_size > 0 and bar_index > lastSig
    strategy.exit("L-TP1", from_entry = "L", qty = aQ1, limit = aTP1, stop = aStop)
    strategy.exit("L-TP2", from_entry = "L", qty = aQ2, limit = aTP2, stop = dynStop)
    strategy.exit("L-TP3", from_entry = "L",            limit = aTP3, stop = dynStop)
if aDir == -1 and strategy.position_size < 0 and bar_index > lastSig
    strategy.exit("S-TP1", from_entry = "S", qty = aQ1, limit = aTP1, stop = aStop)
    strategy.exit("S-TP2", from_entry = "S", qty = aQ2, limit = aTP2, stop = dynStop)
    strategy.exit("S-TP3", from_entry = "S",            limit = aTP3, stop = dynStop)

// ============================== VISUALS ======================================
showScore = input.bool(false, "DEBUG: show L/S score on every bar", group = "Visuals", tooltip = "Prints small numbers above/below each bar so you can see why signals don't fire.")

plot(inSession ? vwap : na, "Session VWAP", color = color.new(color.yellow, 0), linewidth = 2)
plot(inSession ? orH  : na, "OR High",      color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSession ? orL  : na, "OR Low",       color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSession ? orMid: na, "OR Mid",       color = color.new(color.gray,   30), style = plot.style_linebr)
plotshape(rawLong  and strategy.position_size == 0, "OF LONG",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(rawShort and strategy.position_size == 0, "OF SHORT", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL", textcolor = color.white, size = size.small)
plotchar(showScore and inSession and orReady ? longScore  : na, "LongScore",  str.tostring(longScore),  location.belowbar, color = color.new(color.green, 30), size = size.tiny)
plotchar(showScore and inSession and orReady ? shortScore : na, "ShortScore", str.tostring(shortScore), location.abovebar, color = color.new(color.red,   30), size = size.tiny)
bgcolor(inSession ? na : color.new(color.gray, 92), title = "Outside Session")

// Diagnostics table - tells you WHY you're not getting trades.
if barstate.islast
    var table dbg = table.new(position.bottom_right, 2, 8, border_width = 1, border_color = color.new(color.gray, 70))
    table.cell(dbg, 0, 0, "STRATEGY DIAG", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 1, 0, str.tostring(strategy.closedtrades) + " trades", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg, 0, 1, "In RTH session", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 1, inSession ? "YES" : "NO", text_color = inSession ? color.green : color.red, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 2, "OR ready", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 2, orReady ? "YES" : "NO (need " + str.tostring(orBars) + " bars)", text_color = orReady ? color.green : color.red, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 3, "Long score / min", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 3, str.tostring(longScore) + " / " + str.tostring(minScore), text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 4, "Short score / min", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 4, str.tostring(shortScore) + " / " + str.tostring(minScore), text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 5, "Long veto OK", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 5, longOK ? "OK" : "BLOCKED", text_color = longOK ? color.green : color.red, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 6, "Short veto OK", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 6, shortOK ? "OK" : "BLOCKED", text_color = shortOK ? color.green : color.red, text_size = size.tiny, bgcolor = color.new(color.white, 0))
    table.cell(dbg, 0, 7, "Cooldown clear", text_color = color.black, text_size = size.tiny, bgcolor = color.new(color.silver, 60))
    table.cell(dbg, 1, 7, canFire ? "YES" : "NO", text_color = canFire ? color.green : color.red, text_size = size.tiny, bgcolor = color.new(color.white, 0))
