//@version=6
// =============================================================================
// ATR + Daily Volume Profile - signal indicator
// -----------------------------------------------------------------------------
// Pure visualization + signal version. For backtesting, use the matching
// ATR_VolumeProfile_Strategy.pine file.
//
// Builds a developing Volume Profile for the CURRENT TRADING DAY (resets at
// session start), then prints BUY/SELL labels from two patterns:
//   Mean Reversion - poke past VAL/VAH, close back inside with rejection wick
//   Breakout       - close clearly beyond VAH/VAL on a wide ATR-fraction bar
//
// ATR gates volatility (skip dead + spike bars) and sizes the visual SL/TP
// bracket drawn on each signal.
// =============================================================================

indicator("ATR + VP Daily", "ATR-VP", overlay = true,
     max_boxes_count = 500, max_lines_count = 200, max_labels_count = 200)

// ============================== INPUTS =======================================
gVP   = "Volume Profile (Daily)"
vpBins     = input.int(60,    "Profile Bins",  minval = 10, maxval = 200,  group = gVP)
vaPct      = input.float(70.0,"Value Area %", minval = 50.0, maxval = 95.0, step = 1.0, group = gVP)
showVP     = input.bool(true, "Draw Today's Profile Histogram", group = gVP)
showPrev   = input.bool(true, "Show Previous Day POC/VAH/VAL", group = gVP)
showLevels = input.bool(true, "Show Today's POC / VAH / VAL Lines", group = gVP)
vpColor    = input.color(color.new(color.teal, 75),  "Profile Bin Color", group = gVP)
pocColor   = input.color(color.yellow,                "POC Color",        group = gVP)
vaColor    = input.color(color.new(color.aqua, 0),    "VAH/VAL Color",    group = gVP)
prevColor  = input.color(color.new(color.silver, 40), "Prev-Day Color",   group = gVP)

gATR  = "ATR"
atrLen     = input.int(14,    "ATR Length", minval = 2, group = gATR)
atrSLmult  = input.float(1.5, "Visual Stop = N x ATR", minval = 0.3, step = 0.1, group = gATR)
useATRReg  = input.bool(true, "ATR Volatility Regime Filter", group = gATR)
atrAvgLen  = input.int(50,    "Regime Avg Length", minval = 10, group = gATR)
atrMinMul  = input.float(0.3, "ATR Floor (vs avg)", minval = 0.1, step = 0.05, group = gATR)
atrMaxMul  = input.float(4.0, "ATR Ceiling (vs avg)", minval = 1.0, step = 0.1, group = gATR)

gStrat = "Signals"
modeStr    = input.string("Both", "Entry Mode", options = ["Mean Reversion","Breakout","Both"], group = gStrat)
allowLong  = input.bool(true, "Allow BUY Signals",  group = gStrat)
allowShort = input.bool(true, "Allow SELL Signals", group = gStrat)
volConfMul = input.float(1.0, "Entry Vol Multiplier (vs 20-bar avg)", minval = 1.0, step = 0.1, group = gStrat)
cooldown   = input.int(3,     "Cooldown Bars Between Signals", minval = 0, group = gStrat)
minVAbars  = input.int(3,     "Min Bars Into Session Before Signaling", minval = 1, group = gStrat)

gMR   = "Mean Reversion"
mrProxATR  = input.float(0.5, "VA Proximity (ATR fraction)", minval = 0.05, step = 0.05, group = gMR)
mrWickFrac = input.float(0.2, "Min Rejection Wick (fraction of bar range)", minval = 0.0, step = 0.05, group = gMR)

gBO   = "Breakout"
boBufATR   = input.float(0.05, "Breakout Buffer (ATR fraction)", minval = 0.0, step = 0.05, group = gBO)
boRngATR   = input.float(0.4, "Min Bar Range (ATR fraction)",   minval = 0.1, step = 0.1,  group = gBO)

gTP   = "Bracket Drawing"
tp1R      = input.float(1.0, "TP1 R-multiple", minval = 0.3, step = 0.1, group = gTP)
tp2R      = input.float(2.0, "TP2 R-multiple", minval = 0.5, step = 0.1, group = gTP)
tp3R      = input.float(3.0, "TP3 R-multiple", minval = 1.0, step = 0.1, group = gTP)
usePOCtgt = input.bool(true, "Use POC as TP1 (mean reversion)", group = gTP)
riskTrade = input.float(200.0, "Risk Display ($)", minval = 25.0, group = gTP, tooltip = "Used to compute the contract count shown on the bracket. Default $200 lines up with a $400-500 daily loss cap.")
autoCap   = input.bool(true,   "Auto Contract Cap (2 minis / 20 micros)", group = gTP)
maxConMini  = input.int(2,     "Max Contracts (Minis)",  minval = 1, maxval = 20, group = gTP)
maxConMicro = input.int(20,    "Max Contracts (Micros)", minval = 1, maxval = 100, group = gTP)
maxConOvr   = input.int(0,     "Manual Cap Override (0 = auto)", minval = 0, group = gTP)
ovrPV       = input.float(0.0, "Override $/Point (0 = auto)", minval = 0.0, group = gTP)
showBracket = input.bool(true, "Draw SL/TP Bracket on Signal", group = gTP)

gSess = "Session"
useSess    = input.bool(false, "Restrict to Session (RTH)", group = gSess, tooltip = "OFF (default) = 24h, profile resets each chart day. Turn ON only if your session+tz matches the symbol exactly.")
sessStr    = input.session("0930-1555", "Session (NY)", group = gSess)
sessTZ     = input.string("America/New_York", "Timezone", options = ["America/New_York","America/Chicago","Europe/London","Asia/Tokyo","UTC","Australia/Sydney"], group = gSess)

gAnchor = "Daily Anchor (Guaranteed Signal)"
forceDaily = input.bool(true, "Force at least one signal per day", group = gAnchor, tooltip = "If no pattern fires by the anchor bar, show a momentum-based signal.")
anchorBar  = input.int(3,    "Anchor Bar (bars after session open)", minval = 1, maxval = 200, group = gAnchor)
maxPerDay  = input.int(1,    "Max Signals per Session Day", minval = 1, maxval = 10, group = gAnchor)

gViz  = "Visuals"
showSig    = input.bool(true, "Show Entry Labels",  group = gViz)
showStatus = input.bool(true, "Show Status Table",  group = gViz)

// ============================== POINT VALUE ==================================
dpp = ovrPV > 0 ? ovrPV : (syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0)
maxCon = maxConOvr > 0 ? maxConOvr : (autoCap ? (dpp >= 10.0 ? maxConMini : maxConMicro) : maxConMicro)

// ============================== SESSION ======================================
rawInSess    = useSess ? not na(time(timeframe.period, sessStr, sessTZ)) : true
rawSessFlag  = rawInSess ? 1 : 0

var int rawInSessCount = 0
rawInSessCount := rawInSess ? rawInSessCount + 1 : rawInSessCount
sessionStalled = useSess and bar_index > 50 and rawInSessCount == 0

inSess    = sessionStalled or not useSess ? true : rawInSess
isNewSess = sessionStalled or not useSess ? (ta.change(dayofmonth) != 0) : (ta.change(rawSessFlag) > 0)

var int sessBar = 0
sessBar := isNewSess ? 0 : inSess ? sessBar + 1 : sessBar

// ============================== ATR + REGIME =================================
atr     = ta.atr(atrLen)
atrAvg  = ta.sma(atr, atrAvgLen)
atrOK   = not useATRReg or (not na(atrAvg) and atr >= atrAvg * atrMinMul and atr <= atrAvg * atrMaxMul)
avgVol  = ta.sma(volume, 20)
volOK   = volConfMul <= 1.0 or (not na(avgVol) and volume >= avgVol * volConfMul)

// ============================== DAILY VOLUME PROFILE =========================
var float[] bins = array.new_float(vpBins, 0.0)

var float sessHi = na
var float sessLo = na
if isNewSess
    sessHi := high
    sessLo := low
else if inSess
    sessHi := math.max(nz(sessHi, high), high)
    sessLo := math.min(nz(sessLo, low),  low)

float poc = na
float vah = na
float val = na
float binSize = na

if inSess and not na(sessHi) and not na(sessLo) and sessHi > sessLo and sessBar >= 1
    binSize := (sessHi - sessLo) / vpBins
    array.fill(bins, 0.0)
    iters = math.min(sessBar, 1500)
    for i = 0 to iters
        bh = high[i]
        bl = low[i]
        bv = volume[i]
        if not na(bh) and not na(bl) and not na(bv) and bv > 0 and bh >= bl
            fb = math.max(0, math.floor((bl - sessLo) / binSize))
            lb = math.min(vpBins - 1, math.floor((bh - sessLo) / binSize))
            cnt = lb - fb + 1
            if cnt > 0
                pv = bv / cnt
                for b = fb to lb
                    array.set(bins, b, array.get(bins, b) + pv)

    pocIdx = 0
    pocVol = 0.0
    for i = 0 to vpBins - 1
        v = array.get(bins, i)
        if v > pocVol
            pocVol := v
            pocIdx := i

    totalVol = 0.0
    for i = 0 to vpBins - 1
        totalVol += array.get(bins, i)
    target = totalVol * vaPct / 100.0

    int vu = pocIdx
    int vd = pocIdx
    float cur = pocVol
    while cur < target and (vu < vpBins - 1 or vd > 0)
        upV = vu < vpBins - 1 ? array.get(bins, vu + 1) : -1.0
        dnV = vd > 0 ? array.get(bins, vd - 1) : -1.0
        if upV < 0 and dnV < 0
            break
        if upV >= dnV
            vu += 1
            cur += upV
        else
            vd -= 1
            cur += dnV

    poc := sessLo + (pocIdx + 0.5) * binSize
    vah := sessLo + (vu + 1) * binSize
    val := sessLo + vd * binSize

vpReady = not na(poc) and not na(vah) and not na(val) and sessBar >= minVAbars

var float prevPoc = na
var float prevVah = na
var float prevVal = na
if isNewSess and not na(poc[1])
    prevPoc := poc[1]
    prevVah := vah[1]
    prevVal := val[1]

// ============================== ENTRY SIGNALS ===============================
useMR = modeStr == "Mean Reversion" or modeStr == "Both"
useBO = modeStr == "Breakout"      or modeStr == "Both"

barRng = high - low
upWick = high - math.max(open, close)
dnWick = math.min(open, close) - low
upWickFrac = barRng > 0 ? upWick / barRng : 0.0
dnWickFrac = barRng > 0 ? dnWick / barRng : 0.0

mrLong  = useMR and vpReady and low  <= val + atr * mrProxATR and close >  val and close >  open and dnWickFrac >= mrWickFrac
mrShort = useMR and vpReady and high >= vah - atr * mrProxATR and close <  vah and close <  open and upWickFrac >= mrWickFrac

boLong  = useBO and vpReady and close >  vah + atr * boBufATR and barRng >= atr * boRngATR and close >  open
boShort = useBO and vpReady and close <  val - atr * boBufATR and barRng >= atr * boRngATR and close <  open

sigLong  = (mrLong  or boLong)  and allowLong  and atrOK and inSess and volOK
sigShort = (mrShort or boShort) and allowShort and atrOK and inSess and volOK

// Daily anchor: ensures at least one signal per session day.
var float sessOpen    = na
var int   shownToday  = 0
if isNewSess
    sessOpen   := open
    shownToday := 0

anchorActive = forceDaily and inSess and sessBar >= anchorBar and shownToday == 0
useVPdir     = vpReady and not na(poc)
anchorWantsLong = anchorActive and (useVPdir ? close >= poc : close >= nz(sessOpen, close))
anchorLong   = anchorWantsLong and not sigLong  and not sigShort and allowLong
anchorShort  = anchorActive and not anchorWantsLong and not sigLong and not sigShort and allowShort

var int lastSigBar = -10000
canCooldown = bar_index - lastSigBar >= cooldown
quotaOK = shownToday < maxPerDay

fireLong  = (sigLong  or anchorLong)  and canCooldown and quotaOK
fireShort = (sigShort or anchorShort) and canCooldown and quotaOK
if fireLong or fireShort
    lastSigBar := bar_index
    shownToday += 1

// ============================== VISUALS =====================================
plot(showLevels and vpReady ? poc : na, "POC", color = pocColor, linewidth = 2, style = plot.style_linebr)
plot(showLevels and vpReady ? vah : na, "VAH", color = vaColor,  linewidth = 1, style = plot.style_linebr)
plot(showLevels and vpReady ? val : na, "VAL", color = vaColor,  linewidth = 1, style = plot.style_linebr)
plot(showPrev and not na(prevPoc) ? prevPoc : na, "Prev POC", color = prevColor, linewidth = 1, style = plot.style_circles)
plot(showPrev and not na(prevVah) ? prevVah : na, "Prev VAH", color = prevColor, linewidth = 1, style = plot.style_circles)
plot(showPrev and not na(prevVal) ? prevVal : na, "Prev VAL", color = prevColor, linewidth = 1, style = plot.style_circles)

var box[] profBoxes = array.new<box>()
if showVP and barstate.islast and vpReady
    for i = 0 to array.size(profBoxes) - 1
        box.delete(array.get(profBoxes, i))
    array.clear(profBoxes)
    maxV = 0.0
    for i = 0 to vpBins - 1
        v = array.get(bins, i)
        if v > maxV
            maxV := v
    if maxV > 0 and not na(binSize)
        maxWidth = math.max(5, math.min(60, sessBar / 2))
        rightX = bar_index
        for i = 0 to vpBins - 1
            v = array.get(bins, i)
            if v > 0
                w = math.max(1, math.round(v / maxV * maxWidth))
                yLo = sessLo + i * binSize
                yHi = yLo + binSize
                leftX = rightX - w
                array.push(profBoxes, box.new(leftX, yHi, rightX, yLo, border_color = na, bgcolor = vpColor))

// Signal labels
plotshape(showSig and fireLong  and mrLong,                                      "MR Long",      shape.labelup,   location.belowbar, color.new(color.lime,   0), text = "BUY",       textcolor = color.black, size = size.small)
plotshape(showSig and fireLong  and boLong  and not mrLong,                       "BO Long",      shape.labelup,   location.belowbar, color.new(color.green,  0), text = "BUY-BO",    textcolor = color.white, size = size.small)
plotshape(showSig and fireLong  and anchorLong  and not mrLong  and not boLong,   "Anchor Long",  shape.labelup,   location.belowbar, color.new(color.blue,   0), text = "BUY-ANCHOR",textcolor = color.white, size = size.small)
plotshape(showSig and fireShort and mrShort,                                     "MR Short",     shape.labeldown, location.abovebar, color.new(color.red,    0), text = "SELL",      textcolor = color.white, size = size.small)
plotshape(showSig and fireShort and boShort and not mrShort,                      "BO Short",     shape.labeldown, location.abovebar, color.new(color.maroon, 0), text = "SELL-BO",   textcolor = color.white, size = size.small)
plotshape(showSig and fireShort and anchorShort and not mrShort and not boShort,  "Anchor Short", shape.labeldown, location.abovebar, color.new(color.navy,   0), text = "SELL-ANCHOR",textcolor = color.white, size = size.small)

bgcolor(useSess and not inSess ? color.new(color.gray, 92) : na, title = "Outside Session")

// Live bracket on signal
var line  lnE  = na
var line  lnS  = na
var line  lnT1 = na
var line  lnT2 = na
var line  lnT3 = na
var label lbE  = na
var label lbS  = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

f_clear() =>
    if not na(lnE)
        line.delete(lnE)
    if not na(lnS)
        line.delete(lnS)
    if not na(lnT1)
        line.delete(lnT1)
    if not na(lnT2)
        line.delete(lnT2)
    if not na(lnT3)
        line.delete(lnT3)
    if not na(lbE)
        label.delete(lbE)
    if not na(lbS)
        label.delete(lbS)
    if not na(lbT1)
        label.delete(lbT1)
    if not na(lbT2)
        label.delete(lbT2)
    if not na(lbT3)
        label.delete(lbT3)

if showBracket and (fireLong or fireShort)
    f_clear()
    e  = close
    rd = atr * atrSLmult
    isL = fireLong
    sl = isL ? e - rd : e + rd
    t1 = isL ? e + rd * tp1R : e - rd * tp1R
    // POC override for mean reversion
    if usePOCtgt and isL and mrLong and not na(poc) and (poc - e) >= rd * 0.3
        t1 := poc
    if usePOCtgt and not isL and mrShort and not na(poc) and (e - poc) >= rd * 0.3
        t1 := poc
    t2 = isL ? e + rd * tp2R : e - rd * tp2R
    t3 = isL ? e + rd * tp3R : e - rd * tp3R
    rPC = rd * dpp
    qty = rPC > 0 ? math.max(1, math.min(maxCon, math.floor(riskTrade / rPC))) : 1
    risk = rPC * qty
    rx = bar_index + 30
    cE = isL ? color.new(color.green, 0) : color.new(color.red, 0)
    cS = color.new(color.red, 0)
    cT = color.new(color.lime, 0)
    dirTxt = isL ? "BUY" : "SELL"
    lnE  := line.new(bar_index, e,  rx, e,  color = cE, width = 3)
    lnS  := line.new(bar_index, sl, rx, sl, color = cS, width = 2, style = line.style_dashed)
    lnT1 := line.new(bar_index, t1, rx, t1, color = cT, width = 1, style = line.style_dotted)
    lnT2 := line.new(bar_index, t2, rx, t2, color = cT, width = 1, style = line.style_dotted)
    lnT3 := line.new(bar_index, t3, rx, t3, color = cT, width = 2, style = line.style_dotted)
    lbE  := label.new(rx, e,  dirTxt + " " + str.tostring(e, format.mintick) + "  " + str.tostring(qty) + " ct", style = label.style_label_left, color = cE, textcolor = color.white, size = size.normal)
    lbS  := label.new(rx, sl, "SL "  + str.tostring(sl, format.mintick) + "  -$" + str.tostring(risk, "#.##"), style = label.style_label_left, color = color.new(#ffb3b3, 0), textcolor = color.black, size = size.small)
    lbT1 := label.new(rx, t1, "TP1 " + str.tostring(t1, format.mintick) + "  +$" + str.tostring(risk * (math.abs(t1 - e) / rd), "#.##"), style = label.style_label_left, color = color.new(#c8f7c5, 0), textcolor = color.black, size = size.small)
    lbT2 := label.new(rx, t2, "TP2 " + str.tostring(t2, format.mintick) + "  +$" + str.tostring(risk * tp2R, "#.##"), style = label.style_label_left, color = color.new(#a8f5a3, 0), textcolor = color.black, size = size.small)
    lbT3 := label.new(rx, t3, "TP3 " + str.tostring(t3, format.mintick) + "  +$" + str.tostring(risk * tp3R, "#.##"), style = label.style_label_left, color = color.new(#7df077, 0), textcolor = color.black, size = size.small)

// ============================== STATUS TABLE ================================
if showStatus and barstate.islast
    var table t = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.new(color.gray, 60))
    bL = color.new(color.silver, 30)
    bV = color.new(color.white, 0)
    table.cell(t, 0, 0, "ATR-VP",  bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, syminfo.ticker, bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)

    table.cell(t, 0, 1, "$/pt | Cap", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 1, "$" + str.tostring(dpp, "#.##") + " | " + str.tostring(maxCon) + " ct", bgcolor = bV, text_color = color.black, text_size = size.tiny)

    table.cell(t, 0, 2, "ATR", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    atrTxt = str.tostring(atr, format.mintick) + (atrOK ? "  ok" : "  filtered")
    atrC   = atrOK ? color.new(color.green, 0) : color.new(color.red, 0)
    table.cell(t, 1, 2, atrTxt, bgcolor = bV, text_color = atrC, text_size = size.tiny)

    table.cell(t, 0, 3, "POC", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 3, vpReady ? str.tostring(poc, format.mintick) : "-", bgcolor = bV, text_color = color.black, text_size = size.tiny)

    table.cell(t, 0, 4, "VAH / VAL", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 4, vpReady ? str.tostring(vah, format.mintick) + " / " + str.tostring(val, format.mintick) : "-", bgcolor = bV, text_color = color.black, text_size = size.tiny)

    table.cell(t, 0, 5, "Mode", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 5, modeStr, bgcolor = bV, text_color = color.black, text_size = size.tiny)

    table.cell(t, 0, 6, "Session Bars", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 6, str.tostring(sessBar) + (vpReady ? "  ready" : "  warmup"), bgcolor = bV, text_color = vpReady ? color.new(color.green, 0) : color.new(color.orange, 0), text_size = size.tiny)

    sigStr = fireLong and mrLong ? "BUY (MR)" : fireLong and boLong ? "BUY (BO)" : fireShort and mrShort ? "SELL (MR)" : fireShort and boShort ? "SELL (BO)" : "-"
    sigC   = fireLong ? color.new(color.green, 0) : fireShort ? color.new(color.red, 0) : color.black
    table.cell(t, 0, 7, "Last bar", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 7, sigStr, bgcolor = bV, text_color = sigC, text_size = size.tiny)

// ============================== ALERTS ======================================
alertcondition(fireLong,  "VP Long",  "{{ticker}} ATR-VP BUY @ {{close}}")
alertcondition(fireShort, "VP Short", "{{ticker}} ATR-VP SELL @ {{close}}")
alertcondition(fireLong  and mrLong,  "VP MR Long",  "{{ticker}} VP mean-reversion BUY @ {{close}}")
alertcondition(fireShort and mrShort, "VP MR Short", "{{ticker}} VP mean-reversion SELL @ {{close}}")
alertcondition(fireLong  and boLong  and not mrLong,  "VP BO Long",  "{{ticker}} VP breakout BUY @ {{close}}")
alertcondition(fireShort and boShort and not mrShort, "VP BO Short", "{{ticker}} VP breakout SELL @ {{close}}")
