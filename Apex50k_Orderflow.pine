//@version=6
// =============================================================================
// Orderflow Buy/Sell Signal - clean, focused, minimal inputs
// -----------------------------------------------------------------------------
// Tells you when orderflow says BUY (or SELL). That's it.
//
// Three signal tiers based on orderflow strength:
//   A+ (BUY/SELL): Stacked imbalance + strong delta + CVD trending = highest
//                  conviction. Big label on the chart.
//   A  (BUY/SELL): Absorption candle + CVD trending = good entry.
//                  Standard label.
//   B  (small):    Strong delta + CVD trending = okay entry.
//                  Small triangle marker only.
//
// Filters: above session VWAP for buys, below for sells (toggleable).
// =============================================================================

indicator("Orderflow Buy/Sell", "OF-Signal", overlay = true,
     max_lines_count = 50, max_labels_count = 50)

// ============================== INPUTS =======================================
ltfMode    = input.string("Auto", "Lower-TF", options = ["Auto","1S","5S","15S","1","5"], group = "Engine", tooltip = "Auto picks based on chart TF. Tries to read intra-bar volume for buy/sell classification.")
imbThresh  = input.float(1.7, "Imbalance Ratio",         minval = 1.3, step = 0.1, group = "Engine", tooltip = "Buy/Sell volume ratio that counts as a one-sided bar. Lower = more signals.")
strongDel  = input.float(0.20, "Strong Delta % Threshold", minval = 0.10, step = 0.05, group = "Engine", tooltip = "Bar's net delta as fraction of total volume.")
absVolMul  = input.float(1.7, "Absorption Vol Multiplier", minval = 1.1, step = 0.1, group = "Engine")
cvdLook    = input.int(3,    "CVD Trend Lookback Bars",  minval = 1, maxval = 20, group = "Engine", tooltip = "CVD must be higher (or lower for sells) than this many bars ago. Smoothing prevents single-bar noise.")

useVwap    = input.bool(true, "Buys above VWAP only / Sells below", group = "Filter")
vwapBuffer = input.float(0.0, "VWAP Buffer (ATR fraction)", minval = 0.0, step = 0.1, group = "Filter", tooltip = "Allows buys when within this ATR distance below VWAP. 0 = strict.")
allowBuy   = input.bool(true, "Show BUY signals", group = "Filter")
allowSell  = input.bool(true, "Show SELL signals", group = "Filter")
minTier    = input.int(2, "Minimum signal tier (1=A+, 2=A, 3=B)", minval = 1, maxval = 3, group = "Filter", tooltip = "1 = only A+. 2 = A+ and A (default). 3 = all including B markers.")
cooldownBars = input.int(10, "Cooldown bars between same-direction signals", minval = 0, group = "Filter", tooltip = "Prevents signal spam when orderflow conditions hold across many bars. 10 bars on 3m = 30 minutes.")

slATR      = input.float(1.0, "Stop = N x ATR", minval = 0.3, step = 0.1, group = "Risk / SL / TP", tooltip = "Stop loss = N times ATR away from entry. 1.0 = aggressive, 1.5 = conservative.")
tp1R       = input.float(1.0, "TP1 (R-multiple)", minval = 0.3, step = 0.1, group = "Risk / SL / TP", tooltip = "First target as multiple of risk. 1.0 = same distance as stop.")
tp2R       = input.float(2.0, "TP2 (R-multiple)", minval = 0.5, step = 0.1, group = "Risk / SL / TP")
tp3R       = input.float(3.0, "TP3 (R-multiple)", minval = 1.0, step = 0.1, group = "Risk / SL / TP")
riskTrade  = input.float(400.0, "Max $ Risk / Trade", minval = 25.0, group = "Risk / SL / TP")
maxCon     = input.int(20,      "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = "Risk / SL / TP")
ovrPV      = input.float(0.0,   "Override $/Point (0 = auto)", minval = 0.0, group = "Risk / SL / TP", tooltip = "Auto = use chart's built-in point value (correct for MNQ, NQ, MES, ES, etc.).")
showSLTP   = input.bool(true, "Draw entry / SL / TP lines", group = "Risk / SL / TP")

showBars   = input.bool(true, "Color bars by delta strength", group = "Visuals")
showCVD    = input.bool(true, "Plot session CVD overlay",     group = "Visuals")
showVWAP   = input.bool(true, "Plot session VWAP",            group = "Visuals")
showStatus = input.bool(true, "Show status table",            group = "Visuals")

// ============================== ENGINE =======================================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

// Classify each LTF bar's volume into buy/sell using close-vs-mid weighting.
f_classify(o, h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
    [v * bf, v * (1.0 - bf)]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    // Fallback: classify the whole bar (less accurate, used when LTF data is unavailable).
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s

delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

// ============================== SESSION VWAP + CVD ===========================
inRTH    = not na(time(timeframe.period, "0930-1600", "America/New_York"))
sessFlag = inRTH ? 1 : 0
isNewSess = ta.change(sessFlag) > 0

var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta
// 3-bar (or user-set) CVD trend - more permissive than strict last-bar comparison.
cvdRising  = not isNewSess and cvd > nz(cvd[cvdLook])
cvdFalling = not isNewSess and cvd < nz(cvd[cvdLook])

vwap      = ta.vwap(hlc3, isNewSess)
atr14     = ta.atr(14)
// VWAP filter with optional ATR buffer.
aboveVwap = inRTH and close > vwap - atr14 * vwapBuffer
belowVwap = inRTH and close < vwap + atr14 * vwapBuffer

// ============================== ORDERFLOW SIGNALS ============================
// Stacked imbalance: 2+ consecutive one-sided bars.
isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= 2
stackedSell = sellStreak >= 2

// Strong delta bar.
strongUp = deltaPct >  strongDel
strongDn = deltaPct < -strongDel

// Absorption: heavy volume, tight range, closing at extreme = limit orders soaking up flow.
avgVol = ta.sma(volume,     20)
avgRng = ta.sma(high - low, 20)
heavyV = volume > avgVol * absVolMul
tightR = (high - low) < avgRng * 0.5
absorbBuy  = heavyV and tightR and delta > 0 and close >= high - (high - low) * 0.30
absorbSell = heavyV and tightR and delta < 0 and close <= low  + (high - low) * 0.30

// ============================== TIER LOGIC ===================================
// A+ (Tier 1): all three boxes ticked - stacked + strong delta + CVD trending.
// A  (Tier 2): absorption OR stacked, with CVD trending.
// B  (Tier 3): just strong delta with CVD trending.
buyT1 = stackedBuy  and strongUp and cvdRising
buyT2 = (absorbBuy  or stackedBuy)  and cvdRising and not buyT1
buyT3 = strongUp and cvdRising and not buyT1 and not buyT2

sellT1 = stackedSell and strongDn and cvdFalling
sellT2 = (absorbSell or stackedSell) and cvdFalling and not sellT1
sellT3 = strongDn and cvdFalling and not sellT1 and not sellT2

vwapOKBuy  = not useVwap or aboveVwap
vwapOKSell = not useVwap or belowVwap

// Cooldown: prevent signal spam when conditions hold across many bars.
var int lastBuyBar  = -10000
var int lastSellBar = -10000
buyCooldownOK  = bar_index - lastBuyBar  >= cooldownBars
sellCooldownOK = bar_index - lastSellBar >= cooldownBars

// Edge-detect: only fire when tier first becomes true (not every bar conditions hold).
buyT1Edge  = buyT1  and not buyT1[1]
buyT2Edge  = buyT2  and not buyT2[1]
buyT3Edge  = buyT3  and not buyT3[1]
sellT1Edge = sellT1 and not sellT1[1]
sellT2Edge = sellT2 and not sellT2[1]
sellT3Edge = sellT3 and not sellT3[1]

// Apply min tier, direction toggles, edge detection AND cooldown.
fireBuyT1  = allowBuy  and vwapOKBuy  and buyT1Edge  and buyCooldownOK
fireBuyT2  = allowBuy  and vwapOKBuy  and buyT2Edge  and buyCooldownOK and minTier <= 2 and not fireBuyT1
fireBuyT3  = allowBuy  and vwapOKBuy  and buyT3Edge  and buyCooldownOK and minTier <= 3 and not fireBuyT1 and not fireBuyT2
fireSellT1 = allowSell and vwapOKSell and sellT1Edge and sellCooldownOK
fireSellT2 = allowSell and vwapOKSell and sellT2Edge and sellCooldownOK and minTier <= 2 and not fireSellT1
fireSellT3 = allowSell and vwapOKSell and sellT3Edge and sellCooldownOK and minTier <= 3 and not fireSellT1 and not fireSellT2

anyBuy  = fireBuyT1  or fireBuyT2  or fireBuyT3
anySell = fireSellT1 or fireSellT2 or fireSellT3

// Update cooldown trackers.
if anyBuy
    lastBuyBar  := bar_index
if anySell
    lastSellBar := bar_index

// ============================== VISUALS ======================================
barC = na(delta) ? color.gray : delta > 0 ? color.new(color.teal, math.max(0, 80 - int(math.abs(deltaPct) * 80))) : color.new(color.red, math.max(0, 80 - int(math.abs(deltaPct) * 80)))
barcolor(showBars ? barC : na)

// Session CVD scaled to price range (so it sits inside the chart).
cMin = ta.lowest(cvd,  200)
cMax = ta.highest(cvd, 200)
pMin = ta.lowest(low,  200)
pMax = ta.highest(high, 200)
cvdScaled = cMax - cMin > 0 ? pMin + (cvd - cMin) / (cMax - cMin) * (pMax - pMin) : na
plot(showCVD and inRTH ? cvdScaled : na, "Sess CVD", color = color.new(color.orange, 0), linewidth = 2)

plot(showVWAP and inRTH ? vwap : na, "VWAP", color = color.new(color.yellow, 0), linewidth = 2)

// Tier 1 (A+): HUGE label + arrow + bright background flash
plotshape(fireBuyT1,  "BUY A+",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY A+",  textcolor = color.white, size = size.huge)
plotshape(fireBuyT1,  "BUY arrow", shape.arrowup, location.belowbar, color.new(color.lime,  0), size = size.large)
plotshape(fireSellT1, "SELL A+", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL A+", textcolor = color.white, size = size.huge)
plotshape(fireSellT1, "SELL arrow", shape.arrowdown, location.abovebar, color.new(color.maroon, 0), size = size.large)

// Tier 2 (A): large label + arrow
plotshape(fireBuyT2,  "BUY",  shape.labelup,   location.belowbar, color.new(color.lime, 0),    text = "BUY",  textcolor = color.black, size = size.large)
plotshape(fireBuyT2,  "BUY ar2", shape.arrowup, location.belowbar, color.new(color.green, 30), size = size.normal)
plotshape(fireSellT2, "SELL", shape.labeldown, location.abovebar, color.new(color.fuchsia, 0), text = "SELL", textcolor = color.white, size = size.large)
plotshape(fireSellT2, "SELL ar2", shape.arrowdown, location.abovebar, color.new(color.red, 30), size = size.normal)

// Tier 3 (B): bigger marker with subtle text so it's visible at any zoom
plotshape(fireBuyT3,  "buy B",  shape.labelup,   location.belowbar, color.new(color.aqua,    0), text = "b", textcolor = color.black, size = size.normal)
plotshape(fireSellT3, "sell B", shape.labeldown, location.abovebar, color.new(color.maroon,  0), text = "s", textcolor = color.white, size = size.normal)

// Background flash on signal bars - dramatic visual cue
bgcolor(fireBuyT1  ? color.new(color.green, 70)   : na, title = "BUY A+ flash")
bgcolor(fireBuyT2  ? color.new(color.lime,  80)   : na, title = "BUY flash")
bgcolor(fireSellT1 ? color.new(color.red,   70)   : na, title = "SELL A+ flash")
bgcolor(fireSellT2 ? color.new(color.fuchsia, 80) : na, title = "SELL flash")

bgcolor(inRTH ? na : color.new(color.gray, 92), title = "Outside RTH")

// ============================== ENTRY / SL / TP DRAWING ======================
// When a Tier 1 or Tier 2 BUY/SELL fires, calculate entry, stop, three targets,
// and position size, then draw the full bracket on the chart with $ values.
dpp = ovrPV > 0 ? ovrPV : (syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0)

var line  lnE  = na
var line  lnS  = na
var line  lnT1 = na
var line  lnT2 = na
var line  lnT3 = na
var label lbE  = na
var label lbS  = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

f_clear_bracket() =>
    if not na(lnE)
        line.delete(lnE)
    if not na(lnS)
        line.delete(lnS)
    if not na(lnT1)
        line.delete(lnT1)
    if not na(lnT2)
        line.delete(lnT2)
    if not na(lnT3)
        line.delete(lnT3)
    if not na(lbE)
        label.delete(lbE)
    if not na(lbS)
        label.delete(lbS)
    if not na(lbT1)
        label.delete(lbT1)
    if not na(lbT2)
        label.delete(lbT2)
    if not na(lbT3)
        label.delete(lbT3)

trigBuy  = fireBuyT1  or fireBuyT2
trigSell = fireSellT1 or fireSellT2

if showSLTP and (trigBuy or trigSell)
    f_clear_bracket()
    e   = close
    rd  = atr14 * slATR
    sl  = trigBuy ? e - rd : e + rd
    t1  = trigBuy ? e + rd * tp1R : e - rd * tp1R
    t2  = trigBuy ? e + rd * tp2R : e - rd * tp2R
    t3  = trigBuy ? e + rd * tp3R : e - rd * tp3R
    rPC = rd * dpp
    qty = rPC > 0 ? math.max(1, math.min(maxCon, math.floor(riskTrade / rPC))) : 1
    rx  = bar_index + 30
    cE  = trigBuy ? color.new(color.green, 0) : color.new(color.red, 0)
    cS  = color.new(color.red, 0)
    cT  = color.new(color.lime, 0)
    dirTxt = trigBuy ? "BUY" : "SELL"
    riskAmt = rPC * qty
    lnE  := line.new(bar_index, e,  rx, e,  color = cE, width = 3, style = line.style_solid)
    lnS  := line.new(bar_index, sl, rx, sl, color = cS, width = 2, style = line.style_dashed)
    lnT1 := line.new(bar_index, t1, rx, t1, color = cT, width = 1, style = line.style_dotted)
    lnT2 := line.new(bar_index, t2, rx, t2, color = cT, width = 1, style = line.style_dotted)
    lnT3 := line.new(bar_index, t3, rx, t3, color = cT, width = 2, style = line.style_dotted)
    lbE  := label.new(rx, e,  dirTxt + " " + str.tostring(e, format.mintick) + "  " + str.tostring(qty) + " ct", style = label.style_label_left, color = cE,                   textcolor = color.white, size = size.normal)
    lbS  := label.new(rx, sl, "SL "  + str.tostring(sl, format.mintick) + "  -$" + str.tostring(riskAmt, "#.##"), style = label.style_label_left, color = color.new(#ffb3b3, 0), textcolor = color.black, size = size.small)
    lbT1 := label.new(rx, t1, "TP1 " + str.tostring(t1, format.mintick) + "  +$" + str.tostring(riskAmt * tp1R, "#.##"), style = label.style_label_left, color = color.new(#c8f7c5, 0), textcolor = color.black, size = size.small)
    lbT2 := label.new(rx, t2, "TP2 " + str.tostring(t2, format.mintick) + "  +$" + str.tostring(riskAmt * tp2R, "#.##"), style = label.style_label_left, color = color.new(#a8f5a3, 0), textcolor = color.black, size = size.small)
    lbT3 := label.new(rx, t3, "TP3 " + str.tostring(t3, format.mintick) + "  +$" + str.tostring(riskAmt * tp3R, "#.##"), style = label.style_label_left, color = color.new(#7df077, 0), textcolor = color.black, size = size.small)

// ============================== ALERTS =======================================
if fireBuyT1
    alert("OF BUY A+ " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if fireBuyT2
    alert("OF BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if fireSellT1
    alert("OF SELL A+ " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if fireSellT2
    alert("OF SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(anyBuy,  "Any BUY",  "{{ticker}} BUY orderflow signal")
alertcondition(anySell, "Any SELL", "{{ticker}} SELL orderflow signal")
alertcondition(fireBuyT1,  "BUY A+",  "{{ticker}} BUY A+ orderflow signal")
alertcondition(fireSellT1, "SELL A+", "{{ticker}} SELL A+ orderflow signal")

// ============================== STATUS TABLE =================================
if showStatus and barstate.islast
    var table t = table.new(position.top_right, 2, 8, border_width = 1, border_color = color.new(color.gray, 60))
    bL = color.new(color.silver, 30)
    bV = color.new(color.white, 0)
    table.cell(t, 0, 0, "OF-Signal",      bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, syminfo.ticker + " | LTF " + ltfRes, bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)

    table.cell(t, 0, 1, "Delta",         bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 1, str.tostring(delta, "#") + "  (" + str.tostring(deltaPct * 100, "#.0") + "%)", bgcolor = bV, text_color = delta >= 0 ? color.new(color.green, 0) : color.new(color.red, 0), text_size = size.tiny)

    table.cell(t, 0, 2, "Session CVD",   bgcolor = bL, text_color = color.black, text_size = size.tiny)
    cvdC = cvdRising ? color.new(color.green, 0) : cvdFalling ? color.new(color.red, 0) : color.black
    table.cell(t, 1, 2, str.tostring(cvd, "#") + (cvdRising ? "  rising" : cvdFalling ? "  falling" : ""), bgcolor = bV, text_color = cvdC, text_size = size.tiny)

    table.cell(t, 0, 3, "Buy / Sell streak", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 3, str.tostring(buyStreak) + " / " + str.tostring(sellStreak), bgcolor = bV, text_color = color.black, text_size = size.tiny)

    table.cell(t, 0, 4, "Absorption",    bgcolor = bL, text_color = color.black, text_size = size.tiny)
    absStr = absorbBuy ? "BUY" : absorbSell ? "SELL" : "no"
    table.cell(t, 1, 4, absStr, bgcolor = bV, text_color = absorbBuy ? color.new(color.green, 0) : absorbSell ? color.new(color.red, 0) : color.black, text_size = size.tiny)

    table.cell(t, 0, 5, "VWAP",          bgcolor = bL, text_color = color.black, text_size = size.tiny)
    vwapStr = aboveVwap ? "above" : belowVwap ? "below" : "at"
    table.cell(t, 1, 5, vwapStr, bgcolor = bV, text_color = aboveVwap ? color.new(color.green, 0) : belowVwap ? color.new(color.red, 0) : color.black, text_size = size.tiny)

    sigStr = fireBuyT1 ? "BUY A+" : fireBuyT2 ? "BUY" : fireBuyT3 ? "buy (B)" : fireSellT1 ? "SELL A+" : fireSellT2 ? "SELL" : fireSellT3 ? "sell (B)" : "-"
    sigC   = fireBuyT1 or fireBuyT2 or fireBuyT3 ? color.new(color.green, 0) : fireSellT1 or fireSellT2 or fireSellT3 ? color.new(color.red, 0) : color.black
    table.cell(t, 0, 6, "Last bar signal", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 6, sigStr, bgcolor = bV, text_color = sigC, text_size = size.tiny)

    table.cell(t, 0, 7, "Min tier",      bgcolor = bL, text_color = color.black, text_size = size.tiny)
    tierStr = minTier == 1 ? "1 (A+ only)" : minTier == 2 ? "2 (A+ and A)" : "3 (all)"
    table.cell(t, 1, 7, tierStr, bgcolor = bV, text_color = color.black, text_size = size.tiny)
