//@version=6
// =============================================================================
// Apex 50k OF Indicator v2 - matches strategy v2 signal logic
// -----------------------------------------------------------------------------
// Same patterns and filters as the strategy file: OR Breakout + VWAP Pullback,
// HTF bias filter, time-of-day, volatility regime. Plus drawn entry/SL/TP
// lines and Apex risk table.
// =============================================================================

indicator("Apex 50k OF v2", "APX-OF v2", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ============================== INPUTS =======================================
gPat      = "Entry Patterns"
useORBrk  = input.bool(true,  "1. OR Breakout",   group = gPat)
usePull   = input.bool(true,  "2. VWAP Pullback", group = gPat)
useOFTrig = input.bool(false, "3. Pure Orderflow Triggers", group = gPat)

gFilt     = "Filters"
useHTFBias  = input.bool(true,  "HTF Bias (price + slope)", group = gFilt, tooltip = "Long needs HTF close > EMA AND EMA rising; short needs the inverse. Prevents shorting bull pullbacks.")
htfTF       = input.timeframe("60", "HTF Timeframe", group = gFilt)
htfEmaLen   = input.int(50,    "HTF EMA Length",      group = gFilt)
htfSlopeBars= input.int(3,     "HTF Slope Lookback Bars", minval = 1, maxval = 10, group = gFilt)
useVwap     = input.bool(true, "VWAP Veto",            group = gFilt)
useTimeFilt = input.bool(true, "Time-of-Day Filter",   group = gFilt)
skipFirstMin= input.int(10,    "Skip First N Min",     minval = 0, group = gFilt)
skipLunch   = input.bool(false,"Skip Lunch (12-13:30 NY)", group = gFilt)
skipLastMin = input.int(15,    "Skip Last N Min",      minval = 0, group = gFilt)
useVolReg   = input.bool(true, "Volatility Regime Filter", group = gFilt)
atrMin      = input.float(0.3, "ATR Floor (vs avg)",   minval = 0.1, step = 0.05, group = gFilt)
atrMax      = input.float(3.0, "ATR Ceiling (vs avg)", minval = 1.0, step = 0.1, group = gFilt)

gSig      = "Signal Tweaks"
brkMinRng = input.float(0.3,  "OR Break Min Bar Range / ATR", minval = 0.0, step = 0.1, group = gSig)
pullDepth = input.float(0.5,  "Pullback Depth / ATR",   minval = 0.05, step = 0.05, group = gSig)
pullStreak= input.int(3,      "Min Trend Streak for Pullback", minval = 1, group = gSig)
allowLong = input.bool(true,  "Allow Long Entries",  group = gSig)
allowShort= input.bool(true,  "Allow Short Entries", group = gSig)

gOF       = "Orderflow Engine"
ltfMode   = input.string("Auto", "Lower-TF", options = ["Auto","1S","5S","15S","1","5"], group = gOF)
imbThresh = input.float(1.8, "Imbalance Ratio",  minval = 1.3, step = 0.1, group = gOF)
imbStack  = input.int(2,     "Stacked Imb Bars", minval = 1, maxval = 5, group = gOF)
absVolMul = input.float(1.7, "Absorption Vol Mult", minval = 1.1, step = 0.1, group = gOF)
strongDel = input.float(0.20, "Strong Delta % Threshold", minval = 0.10, step = 0.05, group = gOF)

gSess     = "Session"
sessRTH   = input.session("0930-1600", "RTH (NY)",        group = gSess)
flatBy    = input.session("1555-1600", "Force-Flat (NY)", group = gSess)
orMin     = input.int(15, "Opening Range Minutes", minval = 1, maxval = 60, group = gSess)

gRisk     = "Risk / SL / TP"
slMode    = input.string("ATR", "Stop Mode", options = ["ATR","Swing","ATR + Swing"], group = gRisk)
slATR     = input.float(1.0, "ATR Stop Mult", minval = 0.3, step = 0.1, group = gRisk)
swingLen  = input.int(8,     "Swing Lookback", minval = 3, maxval = 30, group = gRisk)
atrLen    = input.int(14,    "ATR Length", group = gRisk)
tp1R      = input.float(0.75, "TP1 R", group = gRisk)
tp2R      = input.float(2.0, "TP2 R", group = gRisk)
tp3R      = input.float(4.0, "TP3 R", group = gRisk)
cooldown  = input.int(0,     "Cooldown Bars", minval = 0, group = gRisk)

gApex     = "Apex 50k"
acctStart = input.float(50000.0, "Starting Balance ($)", group = gApex)
trailDD   = input.float(2000.0,  "Account Trailing DD ($)", group = gApex)
ddLock    = input.float(2100.0,  "Trailing Lock Profit ($)", group = gApex)
riskTrade = input.float(400.0,   "Max $ Risk / Trade", minval = 25.0, group = gApex)
maxCon    = input.int(20,        "Max Contracts (Apex Cap)", minval = 1, maxval = 40, group = gApex)
ovrPV     = input.float(0.0,     "Override $/Point (0 = auto)", minval = 0.0, group = gApex)
useIntraTrail = input.bool(true, "Intraday Peak Trail Halt",  group = gApex, tooltip = "Block new BUY/SELL signals if today's simulated equity drops by Intraday Trail \$ from today's peak.")
intraTrail    = input.float(400.0, "Intraday Peak Trail ($)", minval = 50, group = gApex)

gVis      = "Visuals"
showBars  = input.bool(true, "Color Bars by Delta", group = gVis)
showCVD   = input.bool(true, "Plot Session CVD (scaled)", group = gVis)
showTrade = input.bool(true, "Draw Active Trade", group = gVis)
showTable = input.bool(true, "Show Risk Table", group = gVis)

// ============================== POINT VALUE ==================================
dpp = ovrPV > 0 ? ovrPV : (syminfo.pointvalue > 0 ? syminfo.pointvalue : 1.0)

// ============================== SESSION ======================================
inSess    = not na(time(timeframe.period, sessRTH, "America/New_York"))
sessFlag  = inSess ? 1 : 0
isNewSess = ta.change(sessFlag) > 0
flatNow   = not na(time(timeframe.period, flatBy, "America/New_York"))

var int sessBar = 0
sessBar := isNewSess ? 0 : inSess ? sessBar + 1 : 0

barMin = math.max(1.0, timeframe.in_seconds(timeframe.period) / 60.0)
orBars = math.max(1, int(math.ceil(orMin / barMin)))
inOR   = inSess and sessBar < orBars

var float orH = na
var float orL = na
if isNewSess
    orH := high
    orL := low
else if inOR
    orH := math.max(nz(orH, high), high)
    orL := math.min(nz(orL, low),  low)
orReady = inSess and sessBar >= orBars

vwap      = ta.vwap(hlc3, isNewSess)
aboveVwap = inSess and close > vwap
belowVwap = inSess and close < vwap

atr = ta.atr(atrLen)

// ============================== HTF BIAS (price + slope) =====================
htfClose    = request.security(syminfo.tickerid, htfTF, close, lookahead = barmerge.lookahead_off)
htfEMA      = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen), lookahead = barmerge.lookahead_off)
htfEMAprev  = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfEmaLen)[htfSlopeBars], lookahead = barmerge.lookahead_off)
emaRising   = not na(htfEMA) and not na(htfEMAprev) and htfEMA > htfEMAprev
emaFalling  = not na(htfEMA) and not na(htfEMAprev) and htfEMA < htfEMAprev
htfBull     = not na(htfEMA) and htfClose > htfEMA and emaRising
htfBear     = not na(htfEMA) and htfClose < htfEMA and emaFalling

// ============================== TIME-OF-DAY ==================================
nyHr  = hour(time, "America/New_York")
nyMn  = minute(time, "America/New_York")
nyTM  = nyHr * 60 + nyMn
inLunch     = skipLunch and nyTM >= 12 * 60 and nyTM < 13 * 60 + 30
inFirstSkip = nyTM < (9 * 60 + 30) + skipFirstMin
inLastSkip  = nyTM >= (16 * 60) - skipLastMin
goodTime    = not useTimeFilt or (not inLunch and not inFirstSkip and not inLastSkip)

// ============================== VOL REGIME ===================================
atrAvg = ta.sma(atr, 50)
volOK  = not useVolReg or (not na(atrAvg) and atr >= atrAvg * atrMin and atr <= atrAvg * atrMax)

// ============================== ORDERFLOW ====================================
f_autoLTF() =>
    tf = timeframe.in_seconds(timeframe.period)
    switch
        tf <= 60   => "1S"
        tf <= 300  => "5S"
        tf <= 900  => "15S"
        tf <= 3600 => "1"
        => "5"
ltfRes = ltfMode == "Auto" ? f_autoLTF() : ltfMode

f_classify(o, h, l, c, v) =>
    rng = math.max(h - l, syminfo.mintick)
    bf  = math.max(0.0, math.min(1.0, (c - l) / rng))
    [v * bf, v * (1.0 - bf)]

[buyArr, sellArr] = request.security_lower_tf(syminfo.tickerid, ltfRes, f_classify(open, high, low, close, volume))
float buyVol  = 0.0
float sellVol = 0.0
if array.size(buyArr) > 0
    for i = 0 to array.size(buyArr) - 1
        buyVol  += array.get(buyArr,  i)
        sellVol += array.get(sellArr, i)
else
    [b, s] = f_classify(open, high, low, close, volume)
    buyVol  := b
    sellVol := s
delta    = buyVol - sellVol
totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? delta / totalVol : 0.0

var float cvd = 0.0
cvd := isNewSess ? delta : nz(cvd[1]) + delta

isBuyImb  = buyVol  > sellVol * imbThresh
isSellImb = sellVol > buyVol  * imbThresh
var int buyStreak  = 0
var int sellStreak = 0
buyStreak  := isBuyImb  ? buyStreak  + 1 : 0
sellStreak := isSellImb ? sellStreak + 1 : 0
stackedBuy  = buyStreak  >= imbStack
stackedSell = sellStreak >= imbStack

avgVol = ta.sma(volume,     math.min(20, math.max(5, sessBar + 1)))
avgRng = ta.sma(high - low, math.min(20, math.max(5, sessBar + 1)))
heavyV = volume > avgVol * absVolMul
tightR = (high - low) < avgRng * 0.5
absorbBuy  = heavyV and tightR and delta > 0 and close >= high - (high - low) * 0.30
absorbSell = heavyV and tightR and delta < 0 and close <= low  + (high - low) * 0.30

ofLong  = stackedBuy  or absorbBuy  or deltaPct >  strongDel
ofShort = stackedSell or absorbSell or deltaPct < -strongDel

// ============================== TRIGGERS =====================================
brokeHi    = orReady and not na(orH) and close > orH
brokeLo    = orReady and not na(orL) and close < orL
strongBar  = brkMinRng <= 0 or (high - low) > atr * brkMinRng
firstBrkUp = brokeHi and not brokeHi[1] and strongBar
firstBrkDn = brokeLo and not brokeLo[1] and strongBar

orPatLong  = useORBrk and firstBrkUp
orPatShort = useORBrk and firstBrkDn

var int sessAboveVwap = 0
var int sessBelowVwap = 0
sessAboveVwap := isNewSess ? 0 : (close > vwap ? sessAboveVwap + 1 : 0)
sessBelowVwap := isNewSess ? 0 : (close < vwap ? sessBelowVwap + 1 : 0)
pullLong  = usePull and orReady and sessAboveVwap[1] >= pullStreak and low <= vwap + atr * pullDepth and close > vwap and close > open
pullShort = usePull and orReady and sessBelowVwap[1] >= pullStreak and high >= vwap - atr * pullDepth and close < vwap and close < open

ofPatLong  = useOFTrig and ofLong  and orReady
ofPatShort = useOFTrig and ofShort and orReady

triggerLong  = orPatLong  or pullLong  or ofPatLong
triggerShort = orPatShort or pullShort or ofPatShort

vetoLong   = not useVwap or aboveVwap
vetoShort  = not useVwap or belowVwap
htfOKLong  = not useHTFBias or htfBull
htfOKShort = not useHTFBias or htfBear

allFiltersLong  = goodTime and volOK and vetoLong  and htfOKLong
allFiltersShort = goodTime and volOK and vetoShort and htfOKShort

rawLong  = allowLong  and inSess and not flatNow and triggerLong  and allFiltersLong
rawShort = allowShort and inSess and not flatNow and triggerShort and allFiltersShort

var int lastSig = -1000
canFire = bar_index - lastSig >= cooldown
// Intraday-trail halt suppresses new signals (calculated again here from
// the simulated equity above for indicator-only use).
sessOpen_e   = ta.valuewhen(isNewSess, open, 0)
floatPnL_e   = (close - sessOpen_e) * dpp * math.max(tSize, 1)
simEq_e      = acctStart + floatPnL_e
var float dayPeakSim_e = na
if isNewSess
    dayPeakSim_e := simEq_e
else
    dayPeakSim_e := math.max(nz(dayPeakSim_e, simEq_e), simEq_e)
intraHalted_e = useIntraTrail and (nz(dayPeakSim_e, simEq_e) - simEq_e) >= intraTrail

fireLong  = rawLong  and canFire and not intraHalted_e
fireShort = rawShort and canFire and not fireLong and not intraHalted_e

// ============================== SL / TP ======================================
swingLow  = ta.lowest(low,   math.min(swingLen, math.max(2, sessBar + 1)))
swingHigh = ta.highest(high, math.min(swingLen, math.max(2, sessBar + 1)))

f_long_sl(e) =>
    sla = e - atr * slATR
    sls = swingLow - syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.min(sla, sls)
f_short_sl(e) =>
    sla = e + atr * slATR
    sls = swingHigh + syminfo.mintick * 2
    switch slMode
        "ATR"   => sla
        "Swing" => sls
        => math.max(sla, sls)

// ============================== TRADE STATE ==================================
var float tEntry = na
var float tStop  = na
var float tTP1   = na
var float tTP2   = na
var float tTP3   = na
var float tRdist = na
var int   tDir   = 0
var int   tBar   = na
var int   tSize  = 0

if fireLong
    sl = f_long_sl(close)
    if not na(sl) and close - sl > 0
        tEntry := close
        tStop  := sl
        tRdist := close - sl
        tTP1   := close + tRdist * tp1R
        tTP2   := close + tRdist * tp2R
        tTP3   := close + tRdist * tp3R
        tDir   := 1
        tBar   := bar_index
        lastSig := bar_index
if fireShort
    sl = f_short_sl(close)
    if not na(sl) and sl - close > 0
        tEntry := close
        tStop  := sl
        tRdist := sl - close
        tTP1   := close - tRdist * tp1R
        tTP2   := close - tRdist * tp2R
        tTP3   := close - tRdist * tp3R
        tDir   := -1
        tBar   := bar_index
        lastSig := bar_index

rPC = na(tRdist) ? na : tRdist * dpp
sizeAct = na(rPC) or rPC <= 0 ? 0 : math.max(1, math.min(maxCon, math.floor(riskTrade / rPC)))
if (fireLong or fireShort) and sizeAct > 0
    tSize := sizeAct

// LIVE PREVIEW
liveLongSL  = math.min(close - atr * slATR, swingLow  - syminfo.mintick * 2)
liveShortSL = math.max(close + atr * slATR, swingHigh + syminfo.mintick * 2)
liveBias    = aboveVwap ? 1 : belowVwap ? -1 : 0
liveR       = liveBias ==  1 ? close - liveLongSL : liveBias == -1 ? liveShortSL - close : math.max(close - liveLongSL, liveShortSL - close)
liveRPC     = liveR > 0 ? liveR * dpp : na
livePrev    = na(liveRPC) ? 0 : math.max(1, math.min(maxCon, math.floor(riskTrade / liveRPC)))

hitStop = tDir != 0 and ((tDir == 1 and low  <= tStop) or (tDir == -1 and high >= tStop))
hitTP3  = tDir != 0 and ((tDir == 1 and high >= tTP3)  or (tDir == -1 and low  <= tTP3))
sessEnd = tDir != 0 and isNewSess and bar_index > tBar
if hitStop or hitTP3 or sessEnd or (tDir != 0 and flatNow)
    tDir := 0

// ============================== DRAW TRADE LINES =============================
var line  lnE  = na
var line  lnS  = na
var line  lnT1 = na
var line  lnT2 = na
var line  lnT3 = na
var label lbE  = na
var label lbS  = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

f_clear() =>
    if not na(lnE)
        line.delete(lnE)
    if not na(lnS)
        line.delete(lnS)
    if not na(lnT1)
        line.delete(lnT1)
    if not na(lnT2)
        line.delete(lnT2)
    if not na(lnT3)
        line.delete(lnT3)
    if not na(lbE)
        label.delete(lbE)
    if not na(lbS)
        label.delete(lbS)
    if not na(lbT1)
        label.delete(lbT1)
    if not na(lbT2)
        label.delete(lbT2)
    if not na(lbT3)
        label.delete(lbT3)

if showTrade and (fireLong or fireShort) and tDir != 0
    f_clear()
    rx = bar_index + 30
    lnE  := line.new(bar_index, tEntry, rx, tEntry, color = color.new(color.white, 0), width = 2)
    lnS  := line.new(bar_index, tStop,  rx, tStop,  color = color.new(color.red,   0), width = 2, style = line.style_dashed)
    lnT1 := line.new(bar_index, tTP1,   rx, tTP1,   color = color.new(color.lime,  0), style = line.style_dotted)
    lnT2 := line.new(bar_index, tTP2,   rx, tTP2,   color = color.new(color.lime,  0), style = line.style_dotted)
    lnT3 := line.new(bar_index, tTP3,   rx, tTP3,   color = color.new(color.lime,  0), width = 2, style = line.style_dotted)
    dirTxt = tDir == 1 ? "LONG " : "SHORT "
    lbE  := label.new(rx, tEntry, dirTxt + "Entry " + str.tostring(tEntry, format.mintick) + "  x " + str.tostring(tSize) + " ct", style = label.style_label_left, color = color.new(color.silver, 0), textcolor = color.black, size = size.small)
    lbS  := label.new(rx, tStop,  "SL "  + str.tostring(tStop, format.mintick) + "  (-$" + str.tostring(rPC * tSize, "#.##") + ")",                  style = label.style_label_left, color = color.new(#ffb3b3, 0),     textcolor = color.black, size = size.small)
    lbT1 := label.new(rx, tTP1,   "TP1 " + str.tostring(tTP1, format.mintick) + "  (+$" + str.tostring(rPC * tp1R * tSize, "#.##") + ")",            style = label.style_label_left, color = color.new(#c8f7c5, 0),     textcolor = color.black, size = size.small)
    lbT2 := label.new(rx, tTP2,   "TP2 " + str.tostring(tTP2, format.mintick) + "  (+$" + str.tostring(rPC * tp2R * tSize, "#.##") + ")",            style = label.style_label_left, color = color.new(#a8f5a3, 0),     textcolor = color.black, size = size.small)
    lbT3 := label.new(rx, tTP3,   "TP3 " + str.tostring(tTP3, format.mintick) + "  (+$" + str.tostring(rPC * tp3R * tSize, "#.##") + ")",            style = label.style_label_left, color = color.new(#7df077, 0),     textcolor = color.black, size = size.small)

// ============================== PLOTS ========================================
barC = na(delta) ? color.gray : delta > 0 ? color.new(color.teal, math.max(0, 80 - int(math.abs(deltaPct) * 80))) : color.new(color.red, math.max(0, 80 - int(math.abs(deltaPct) * 80)))
barcolor(showBars ? barC : na)

cMin = ta.lowest(cvd,  math.max(5, sessBar + 1))
cMax = ta.highest(cvd, math.max(5, sessBar + 1))
pMin = ta.lowest(low,  math.max(5, sessBar + 1))
pMax = ta.highest(high, math.max(5, sessBar + 1))
cvdScaled = cMax - cMin > 0 ? pMin + (cvd - cMin) / (cMax - cMin) * (pMax - pMin) : na
plot(showCVD and inSess ? cvdScaled : na, "Session CVD", color = color.new(color.orange, 0), linewidth = 2)

plot(inSess ? vwap : na, "VWAP",    color = color.new(color.yellow, 0), linewidth = 2)
plot(inSess ? orH  : na, "OR High", color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess ? orL  : na, "OR Low",  color = color.new(color.aqua,    0), style = plot.style_linebr)
plot(inSess and useHTFBias ? htfEMA : na, "HTF EMA", color = color.new(color.fuchsia, 30))

plotshape(fireLong,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.normal)
plotshape(fireShort, "SELL", shape.labeldown, location.abovebar, color.new(color.red,   0), text = "SELL", textcolor = color.white, size = size.normal)

plotshape(orPatLong,  "ORBL",  shape.circle, location.belowbar, color.new(color.green,  60), size = size.tiny)
plotshape(pullLong,   "PullL", shape.cross,  location.belowbar, color.new(color.lime,   30), size = size.tiny)
plotshape(orPatShort, "ORBS",  shape.circle, location.abovebar, color.new(color.red,    60), size = size.tiny)
plotshape(pullShort,  "PullS", shape.cross,  location.abovebar, color.new(color.maroon, 30), size = size.tiny)

bgcolor(inSess ? na : color.new(color.gray, 92), title = "Outside Session")
bgcolor(inSess and not goodTime ? color.new(color.orange, 92) : na, title = "Bad Time")
bgcolor(inSess and not volOK ? color.new(color.purple, 92) : na, title = "Vol Block")

// ============================== ALERTS =======================================
if fireLong
    alert("APX-OF v2 BUY " + syminfo.ticker + " Entry=" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if fireShort
    alert("APX-OF v2 SELL " + syminfo.ticker + " Entry=" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
alertcondition(fireLong,  "BUY",  "{{ticker}} BUY  Entry={{close}}")
alertcondition(fireShort, "SELL", "{{ticker}} SELL Entry={{close}}")

// ============================== RISK TABLE ===================================
sessOpen = ta.valuewhen(isNewSess, open, 0)
floatPnL = (close - sessOpen) * dpp * math.max(tSize, 1)
simEq    = acctStart + floatPnL

// Account-trail floor (Apex).
peakEq   = ta.highest(simEq, 1000)
peakClp  = math.min(peakEq, acctStart + ddLock)
ddCap    = peakClp - trailDD
cushion  = simEq - ddCap

// Intraday peak trail tracking (resets each session).
var float dayPeakSim = na
if isNewSess
    dayPeakSim := simEq
else
    dayPeakSim := math.max(nz(dayPeakSim, simEq), simEq)
intraDD     = nz(dayPeakSim, simEq) - simEq
intraHalted = useIntraTrail and intraDD >= intraTrail

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 14, border_width = 1)
    bL = color.new(color.silver, 30)
    bV = color.new(color.white,  0)
    table.cell(t, 0, 0, "APX-OF v2",                          bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, syminfo.ticker + " | $" + str.tostring(dpp, "#.##") + "/pt", bgcolor = color.new(color.black, 0), text_color = color.white, text_size = size.small)
    htfStr = htfBull ? "BULL" : htfBear ? "BEAR" : "FLAT"
    table.cell(t, 0, 1, "HTF bias",     bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 1, htfStr, bgcolor = bV, text_color = htfBull ? color.green : htfBear ? color.red : color.black, text_size = size.tiny)
    table.cell(t, 0, 2, "Vol regime",   bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 2, volOK ? "OK" : "BLOCKED", bgcolor = bV, text_color = volOK ? color.green : color.red, text_size = size.tiny)
    table.cell(t, 0, 3, "Time window",  bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 3, goodTime ? "OK" : (inLunch ? "LUNCH" : inFirstSkip ? "OPEN" : "CLOSE"), bgcolor = bV, text_color = goodTime ? color.green : color.red, text_size = size.tiny)
    table.cell(t, 0, 4, "OR pat L/S",   bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 4, (orPatLong ? "Y" : "N") + " / " + (orPatShort ? "Y" : "N"), bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 5, "Pull L/S",     bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 5, (pullLong ? "Y" : "N") + " / " + (pullShort ? "Y" : "N"), bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 6, "Sess CVD",     bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 6, str.tostring(cvd, "#"), bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 7, "Trade",        bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 7, tDir == 1 ? "LONG OPEN" : tDir == -1 ? "SHORT OPEN" : "FLAT", bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 8, "Entry/SL/TPs", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    tpsStr = na(tEntry) ? "-" : str.tostring(tEntry, format.mintick) + " / " + str.tostring(tStop, format.mintick) + " / " + str.tostring(tTP1, format.mintick) + " / " + str.tostring(tTP2, format.mintick) + " / " + str.tostring(tTP3, format.mintick)
    table.cell(t, 1, 8, tpsStr, bgcolor = bV, text_color = color.black, text_size = size.tiny)
    sizeShow = tDir != 0 and not na(rPC) ? tSize : livePrev
    rpcShow  = tDir != 0 and not na(rPC) ? rPC : liveRPC
    table.cell(t, 0, 9, tDir != 0 ? "Size (active)" : "Size (preview)", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    sizeStr = na(rpcShow) or sizeShow <= 0 ? "-" : str.tostring(sizeShow) + " ct  ($" + str.tostring(rpcShow * sizeShow, "#.##") + ")"
    table.cell(t, 1, 9, sizeStr, bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 10, "Reward 1R/2R/3R", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    rewStr = na(rpcShow) or sizeShow <= 0 ? "-" : "$" + str.tostring(rpcShow * tp1R * sizeShow, "#.##") + " / $" + str.tostring(rpcShow * tp2R * sizeShow, "#.##") + " / $" + str.tostring(rpcShow * tp3R * sizeShow, "#.##")
    table.cell(t, 1, 10, rewStr, bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 11, "Trail DD Cap", bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 11, "$" + str.tostring(ddCap, "#.##"), bgcolor = bV, text_color = color.black, text_size = size.tiny)
    table.cell(t, 0, 12, "Cushion",      bgcolor = bL, text_color = color.black, text_size = size.tiny)
    table.cell(t, 1, 12, "$" + str.tostring(cushion, "#.##"), bgcolor = bV, text_color = cushion < 500 ? color.red : cushion < 1000 ? color.orange : color.green, text_size = size.tiny)
    if useIntraTrail
        table.cell(t, 0, 13, "Intraday DD",  bgcolor = bL, text_color = color.black, text_size = size.tiny)
        table.cell(t, 1, 13, "$" + str.tostring(intraDD, "#.##") + " / $" + str.tostring(intraTrail, "#.##") + (intraHalted ? "  HALT" : ""), bgcolor = bV, text_color = intraHalted ? color.red : intraDD > intraTrail * 0.7 ? color.orange : color.green, text_size = size.tiny)
